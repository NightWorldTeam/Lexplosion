<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Lexplosion.UI.WPF.Controls">

    <Style TargetType="{x:Type local:AnimatedSidebarItemsControl}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:AnimatedSidebarItemsControl}">
                    <ControlTemplate.Resources>
                        <!-- Only the destination is supplied in code; motion lives in XAML. -->
                        <DoubleAnimation x:Key="SelectionMotion" Duration="0:0:0.26">
                            <DoubleAnimation.EasingFunction>
                                <CubicEase EasingMode="EaseInOut" />
                            </DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                    </ControlTemplate.Resources>
                    <Grid>
                        <ItemsPresenter />
                        <Border
                            x:Name="PART_SelectionCaret"
                            Width="5"
                            Height="40"
                            Margin="-16,0,0,0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Background="{DynamicResource ActivitySolidColorBrush}"
                            CornerRadius="0,5,5,0"
                            IsHitTestVisible="False"
                            Visibility="Collapsed">
                            <Border.RenderTransform>
                                <TranslateTransform Y="0" />
                            </Border.RenderTransform>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
