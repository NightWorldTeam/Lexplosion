<UserControl
    x:Class="Lexplosion.UI.WPF.Controls.ImageGallery"
    x:Name="GalleryRoot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:WpfToolkit.Controls;assembly=VirtualizingWrapPanel"
    xmlns:converters="clr-namespace:Lexplosion.UI.WPF.Core.Converters"
    xmlns:local="clr-namespace:Lexplosion.UI.WPF.Controls"
    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <UserControl.Resources>
        <x:Array x:Key="ThumbnailSizes" Type="{x:Type sys:Double}">
            <sys:Double>200</sys:Double>
            <sys:Double>110</sys:Double>
        </x:Array>
    </UserControl.Resources>

    <ListBox
        ItemsSource="{Binding ItemsSource, ElementName=GalleryRoot}"
        Style="{StaticResource TransparentListBox}">
        <ListBox.ItemTemplate>
            <DataTemplate>
                <Button
                    Width="200"
                    Height="110"
                    Command="{Binding OpenImageCommand, RelativeSource={RelativeSource AncestorType={x:Type local:ImageGallery}}}"
                    Cursor="Hand"
                    CommandParameter="{Binding}"
                    Focusable="True">
                    <Button.Template>
                        <ControlTemplate TargetType="{x:Type Button}">

                            <Grid Margin="0,8,8,0">

                                <Border
                                    Width="{Binding ActualWidth, ElementName=Border}"
                                    Height="{Binding ActualHeight, ElementName=Border}"
                                    Background="Black"
                                    CornerRadius="5" />

                                <Border
                                    x:Name="Border"
                                    Width="200"
                                    Height="110"
                                    CornerRadius="5">

                                    <Border.CacheMode>
                                        <BitmapCache />
                                    </Border.CacheMode>

                                    <Border.Background>
                                        <ImageBrush ImageSource="{Binding Converter={converters:ImageToThumbnailConverter}, ConverterParameter={StaticResource ThumbnailSizes}}" Stretch="UniformToFill" />
                                    </Border.Background>

                                </Border>
                            </Grid>

                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Border" Property="Opacity" Value="0.7" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </DataTemplate>
        </ListBox.ItemTemplate>
        <ListBox.ItemsPanel>
            <ItemsPanelTemplate>
                <controls:VirtualizingWrapPanel
                    Margin="0,0,0,32"
                    IsItemsHost="True"
                    SpacingMode="None"
                    StretchItems="False" />
            </ItemsPanelTemplate>
        </ListBox.ItemsPanel>
    </ListBox>
</UserControl>
