<UserControl x:Class="Lexplosion.UI.WPF.Mvvm.Views.Pages.AddonDetails.AddonDetailsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Lexplosion.UI.WPF.Controls"
             xmlns:converters="clr-namespace:Lexplosion.UI.WPF.Core.Converters"
             xmlns:extensions="clr-namespace:Lexplosion.UI.WPF.Extensions"
             Background="{DynamicResource PageSolidColorBrush}"
             ClipToBounds="True">
    <UserControl.Resources>
        <!-- The tab strip has one shared left inset and consistent 24px spacing.
             Do not use a Margin on just the first TabItem: it breaks the rhythm. -->
        <Style x:Key="DetailsTab" TargetType="{x:Type TabItem}">
            <Setter Property="Height" Value="46"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TabItem}">
                        <Grid Margin="0,0,24,0" Background="Transparent" Cursor="Hand">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="3"/>
                            </Grid.RowDefinitions>
                            <ContentPresenter x:Name="TabHeader" HorizontalAlignment="Center" VerticalAlignment="Center"
                                              ContentSource="Header" TextBlock.FontSize="{Binding TabFontSize, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                              TextBlock.Foreground="{DynamicResource SecondaryForegroundSolidColorBrush}"/>
                            <Border x:Name="Underline" Grid.Row="1" Background="{DynamicResource ActivitySolidColorBrush}"
                                    CornerRadius="2,2,0,0" Visibility="Collapsed"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabHeader" Property="TextBlock.Foreground" Value="{DynamicResource PrimaryForegroundSolidColorBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Underline" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="TabHeader" Property="TextBlock.Foreground" Value="{DynamicResource ActivitySolidColorBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A fixed WPF tab row is more predictable than the platform TabControl
             template, especially next to the separately hosted WebView2 window. -->
        <Style x:Key="DetailsTabControl" TargetType="{x:Type TabControl}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TabControl}">
                        <Grid Background="{TemplateBinding Background}" ClipToBounds="True">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="46"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border BorderBrush="{DynamicResource SeparateSolidColorBrush}"
                                    BorderThickness="0,0,0,1">
                                <TabPanel x:Name="HeaderPanel" IsItemsHost="True" HorizontalAlignment="Left"
                                          VerticalAlignment="Stretch" Margin="72,0,0,0"/>
                            </Border>
                            <ContentPresenter x:Name="PART_SelectedContentHost" Grid.Row="1"
                                              ContentSource="SelectedContent"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DetailsIconButton" TargetType="{x:Type Button}">
            <Setter Property="Width" Value="38"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="{DynamicResource PrimarySolidColorBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SeparateSolidColorBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundSolidColorBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="ButtonSurface" CornerRadius="8" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonSurface" Property="BorderBrush" Value="{DynamicResource ActivitySolidColorBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Opacity" Value="0.75"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Compact resource action; intentionally not a full-width CTA. -->
        <Style x:Key="DetailsExternalLink" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0,5,0,5"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter x:Name="LinkText" HorizontalAlignment="Left"
                                              VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="LinkText" Property="Opacity" Value="0.76"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="LinkText" Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>


        <Style x:Key="DetailsActionButton" TargetType="{x:Type Button}">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="{DynamicResource PrimarySolidColorBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SeparateSolidColorBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundSolidColorBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource ActivitySolidColorBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Surface" Property="Opacity" Value="0.82"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DetailsInfoLabel" TargetType="{x:Type TextBlock}"
               BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="{Binding InfoLabelFontSize, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"/>
            <Setter Property="Margin" Value="0,0,0,7"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryForegroundSolidColorBrush}"/>
        </Style>
        <Style x:Key="DetailsInfoValue" TargetType="{x:Type TextBlock}"
               BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="{Binding InfoValueFontSize, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundSolidColorBrush}"/>
        </Style>
        <Style x:Key="DetailsSectionDivider" TargetType="{x:Type Border}">
            <Setter Property="Height" Value="1"/>
            <Setter Property="Margin" Value="0,18,0,18"/>
            <Setter Property="Background" Value="{DynamicResource SeparateSolidColorBrush}"/>
        </Style>
        <DataTemplate x:Key="DetailsChipTemplate">
            <Border Background="{DynamicResource LayoutTabSolidColorBrush}" BorderBrush="{DynamicResource SeparateSolidColorBrush}"
                    BorderThickness="1" CornerRadius="6" Margin="0,0,8,8"
                    Padding="{Binding InfoChipPadding, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}">
                <TextBlock Text="{Binding}" FontSize="{Binding InfoChipFontSize, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                           Foreground="{DynamicResource PrimaryForegroundSolidColorBrush}"/>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid x:Name="DetailRoot" SizeChanged="OnDetailSizeChanged" Background="{DynamicResource PageSolidColorBrush}">
        <Grid.RowDefinitions>
            <!-- MainWindow.xaml: WindowHeaderContainer is 40px and overlays content. -->
            <RowDefinition Height="40"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border x:Name="HeaderSurface" Grid.Row="1" Background="{DynamicResource LayoutTabSolidColorBrush}"
                BorderBrush="{DynamicResource LayoutTabBorderSolidColorBrush}"
                BorderThickness="0,0,0,1" Padding="24,12,24,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="BackButton" Grid.Column="0" Width="34" Height="34"
                        VerticalAlignment="Top" Margin="0,3,0,0" FontSize="19"
                        Style="{StaticResource DetailsIconButton}" Content="←" ToolTip="Назад к каталогу"
                        Click="OnBackClick"/>

                <Border x:Name="AddonLogo" Grid.Column="1" Width="64" Height="64" Margin="14,0,16,0"
                        VerticalAlignment="Center" CornerRadius="11"
                        Background="{Binding SelectedAddon.Logo, Converter={converters:ImageSourceNullValidateConverter}}"/>

                <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,22,0">
                    <TextBlock x:Name="AddonTitle" Text="{Binding SelectedAddon.Name}" ToolTip="{Binding SelectedAddon.Name}"
                               FontSize="22" FontWeight="SemiBold"
                               Foreground="{DynamicResource PrimaryForegroundSolidColorBrush}"
                               TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                    <TextBlock x:Name="AddonSummary" Text="{Binding SelectedAddon.Description}" ToolTip="{Binding SelectedAddon.Description}" FontSize="12"
                               Foreground="{DynamicResource SecondaryForegroundSolidColorBrush}"
                               TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Margin="0,4,0,0"/>
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <TextBlock Text="{Binding SelectedAddon.Author}"
                                   FontSize="{Binding InfoLabelFontSize, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                   TextTrimming="CharacterEllipsis" Foreground="{DynamicResource SecondaryForegroundSolidColorBrush}"/>
                        <TextBlock Text="  ·  "
                                   FontSize="{Binding InfoLabelFontSize, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" Foreground="{DynamicResource SecondaryForegroundSolidColorBrush}"/>
                        <TextBlock Text="{Binding SelectedAddon.DownloadCount, StringFormat='{}{0:N0} загрузок'}"
                                   FontSize="{Binding InfoLabelFontSize, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" Foreground="{DynamicResource SecondaryForegroundSolidColorBrush}"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <controls:AdvancedButton x:Name="HeaderInstallButton" Height="38" MinWidth="128"
                                             Padding="16,0" FontSize="13"
                                             VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                                             Command="{Binding InstallAddonCommand}" CommandParameter="{Binding SelectedAddon}">
                        <controls:AdvancedButton.Style>
                            <Style TargetType="{x:Type controls:AdvancedButton}" BasedOn="{StaticResource sm-default}">
                                <Setter Property="Content" Value="{DynamicResource Install}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedAddon.IsInstalled}" Value="True">
                                        <Setter Property="Content" Value="{DynamicResource Installed}"/>
                                        <Setter Property="IsEnabled" Value="False"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding SelectedAddon.UpdateAvailable}" Value="True">
                                        <Setter Property="Content" Value="{DynamicResource Update}"/>
                                        <Setter Property="IsEnabled" Value="True"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding SelectedAddon.IsLoading}" Value="True">
                                        <Setter Property="IsEnabled" Value="False"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </controls:AdvancedButton.Style>
                    </controls:AdvancedButton>

                    <Button x:Name="HeaderDeleteButton" Margin="10,0,0,0" MinWidth="98"
                            Style="{StaticResource DetailsActionButton}" ToolTip="Удалить дополнение"
                            Click="OnDeleteClick"
                            Visibility="{Binding SelectedAddon.IsInstalled, Converter={converters:BooleanToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal">
                            <Path Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center"
                                  Data="M4,2 L12,2 M5,2 L5,13 M11,2 L11,13 M3,4 L13,4 M7,2 L7,1 L9,1 L9,2 M6,6 L6,11 M10,6 L10,11 M4,13 L12,13"
                                  Stroke="{DynamicResource PrimaryForegroundSolidColorBrush}" StrokeThickness="1.5"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                            <TextBlock Text="Удалить" Margin="8,0,0,0" VerticalAlignment="Center" FontSize="12" FontWeight="Medium"
                                       Foreground="{DynamicResource PrimaryForegroundSolidColorBrush}"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="InformationButton" Grid.Column="4" Margin="10,0,0,0" FontSize="16" FontWeight="SemiBold"
                            Style="{StaticResource DetailsIconButton}" Content="i" ToolTip="Информация о моде"
                            Click="OnInformationClick"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="2" ClipToBounds="True">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition x:Name="InformationColumn" Width="0"/>
            </Grid.ColumnDefinitions>

            <TabControl x:Name="DetailsTabs" Grid.Column="0" Background="Transparent"
                        Style="{StaticResource DetailsTabControl}"
                        BorderThickness="0" Padding="0" SelectionChanged="OnTabSelectionChanged">
                <TabControl.Resources>
                    <Style TargetType="{x:Type TabItem}" BasedOn="{StaticResource DetailsTab}"/>
                </TabControl.Resources>
                <TabItem Header="Описание">
                    <Grid x:Name="DescriptionHost" Background="{DynamicResource PageSolidColorBrush}" ClipToBounds="True">
                        <Grid x:Name="BrowserHost" Background="{DynamicResource PageSolidColorBrush}"/>
                        <!-- Keep the browser behind an opaque native-WPF loading surface. -->
                        <Grid x:Name="LoadingOverlay" Background="{DynamicResource PageSolidColorBrush}" IsHitTestVisible="False">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24">
                                <ProgressBar x:Name="LoadingBar" Width="110" Height="3" IsIndeterminate="True"
                                             Foreground="{DynamicResource ActivitySolidColorBrush}"/>
                                <TextBlock x:Name="LoadingText" Text="Загрузка описания…" FontSize="12"
                                           HorizontalAlignment="Center" TextAlignment="Center" Margin="0,14,0,0"
                                           Foreground="{DynamicResource SecondaryForegroundSolidColorBrush}"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </TabItem>
                <TabItem Header="Галерея">
                    <ScrollViewer Background="{DynamicResource PageSolidColorBrush}" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="28,26,28,36" MaxWidth="1040" HorizontalAlignment="Stretch">
                            <TextBlock x:Name="GalleryEmptyText" Text="Загрузка галереи…" Margin="0,14"
                                       FontSize="{Binding InfoValueFontSize, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                       Foreground="{DynamicResource SecondaryForegroundSolidColorBrush}" TextAlignment="Center"/>
                            <ItemsControl x:Name="GalleryItems">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{DynamicResource SeparateSolidColorBrush}" BorderThickness="1"
                                                Background="{DynamicResource LayoutTabSolidColorBrush}"
                                                CornerRadius="10" Margin="0,0,0,16" Padding="10">
                                            <Image Source="{Binding}" Stretch="Uniform" MaxHeight="550" SnapsToDevicePixels="True"/>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
                <TabItem Header="Версии">
                    <Grid Background="{DynamicResource PageSolidColorBrush}" Margin="28,26,28,24">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock x:Name="VersionsStatus" Text="Выберите вкладку для загрузки версий."
                                   Margin="0,0,0,14"
                                   FontSize="{Binding InfoLabelFontSize, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                   Foreground="{DynamicResource SecondaryForegroundSolidColorBrush}"/>
                        <ListBox x:Name="VersionsList" Grid.Row="1" SelectionChanged="OnVersionSelectionChanged"
                                 Background="{DynamicResource LayoutTabSolidColorBrush}"
                                 BorderBrush="{DynamicResource SeparateSolidColorBrush}"
                                 BorderThickness="1" Padding="6"
                                 FontSize="{Binding InfoValueFontSize, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                 Foreground="{DynamicResource PrimaryForegroundSolidColorBrush}">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="{x:Type ListBoxItem}">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Padding" Value="12,11"/>
                                    <Setter Property="Margin" Value="0,0,0,3"/>
                                </Style>
                            </ListBox.ItemContainerStyle>
                        </ListBox>
                        <controls:AdvancedButton x:Name="InstallVersionButton" Grid.Row="2" HorizontalAlignment="Right"
                                                 Margin="0,16,0,0" Height="38" MinWidth="208"
                                                 IsEnabled="False" Content="Установить выбранную версию"
                                                 FontSize="{Binding InfoActionFontSize, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                 Padding="16,0" Style="{StaticResource sm-default}"
                                                 Click="OnInstallVersionClick"/>
                    </Grid>
                </TabItem>
            </TabControl>

            <Button x:Name="InformationScrim" Grid.Column="0" Visibility="Collapsed"
                    Background="#96000000" BorderThickness="0" Opacity="1" Cursor="Hand"
                    Click="OnInformationScrimClick"/>

            <!-- Reserve physical width for WebView2 (HWND airspace), never overlay the sidebar. -->
            <Border x:Name="InformationPanel" Grid.Column="1" Visibility="Collapsed"
                    Background="{DynamicResource PrimarySolidColorBrush}"
                    BorderBrush="{DynamicResource SeparateSolidColorBrush}" BorderThickness="1,0,0,0"
                    ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Margin="24,16,18,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="InformationPanelTitle" Text="О дополнении" VerticalAlignment="Center"
                                   FontSize="{Binding InfoTitleFontSize, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                   FontWeight="SemiBold" Foreground="{DynamicResource PrimaryForegroundSolidColorBrush}"/>
                        <Button x:Name="CloseInformationButton" Grid.Column="1" Width="30" Height="30"
                                Style="{StaticResource DetailsIconButton}" Content="×" FontSize="20"
                                ToolTip="Закрыть информацию" Click="OnInformationClick"/>
                    </Grid>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="InformationStack" Margin="24,6,22,30">
                            <TextBlock Style="{StaticResource DetailsInfoLabel}" Text="Автор"/>
                            <TextBlock Style="{StaticResource DetailsInfoValue}" Text="{Binding SelectedAddon.Author}"/>
                            <Border Style="{StaticResource DetailsSectionDivider}"/>

                            <TextBlock Style="{StaticResource DetailsInfoLabel}" Text="Обновлено"/>
                            <TextBlock Style="{StaticResource DetailsInfoValue}" Text="{Binding SelectedAddon.LastUpdated, TargetNullValue=—, FallbackValue=—}"/>
                            <Border Style="{StaticResource DetailsSectionDivider}"/>

                            <TextBlock Style="{StaticResource DetailsInfoLabel}" Text="Версии Minecraft"/>
                            <ItemsControl x:Name="MinecraftVersionsItems" ItemTemplate="{StaticResource DetailsChipTemplate}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                            <Border Style="{StaticResource DetailsSectionDivider}"/>

                            <TextBlock Style="{StaticResource DetailsInfoLabel}" Text="Загрузчики"/>
                            <ItemsControl x:Name="ModloadersItems" ItemTemplate="{StaticResource DetailsChipTemplate}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                            <Border Style="{StaticResource DetailsSectionDivider}"/>

                            <TextBlock Style="{StaticResource DetailsInfoLabel}" Text="Категории"/>
                            <ItemsControl x:Name="CategoryItems" ItemTemplate="{StaticResource DetailsChipTemplate}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>

                            <Border Style="{StaticResource DetailsSectionDivider}"/>

                            <TextBlock Style="{StaticResource DetailsInfoLabel}" Text="Источник"/>
                            <!-- Reuse Lexplosion's own Path Data resources (Resources/Icons.xaml),
                                 not placeholder letters or downloaded assets. -->
                            <Border x:Name="ProjectSourceBadge" Margin="0,0,0,6" Padding="10,7" CornerRadius="7"
                                    Background="{DynamicResource LayoutTabSolidColorBrush}"
                                    BorderBrush="{DynamicResource SeparateSolidColorBrush}" BorderThickness="1"
                                    HorizontalAlignment="Left">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path x:Name="ProjectModrinthIcon" Width="20" Height="20" Stretch="Uniform"
                                          Fill="#1BD96A" VerticalAlignment="Center"
                                          extensions:PathExtensions.StringData="{StaticResource PDModrinth}"/>
                                    <Path x:Name="ProjectCurseforgeIcon" Width="20" Height="20" Stretch="Uniform"
                                          Fill="#F16436" VerticalAlignment="Center" Visibility="Collapsed"
                                          extensions:PathExtensions.StringData="{StaticResource PDCurseforge}"/>
                                    <Path x:Name="ProjectOtherIcon" Width="20" Height="20" Stretch="Uniform"
                                          Fill="{DynamicResource SecondaryForegroundSolidColorBrush}"
                                          Visibility="Collapsed" VerticalAlignment="Center"
                                          extensions:PathExtensions.StringData="{StaticResource PDPublic}"/>
                                    <TextBlock x:Name="ProjectSourceLabel" Text="Modrinth" Margin="10,0,0,0" VerticalAlignment="Center"
                                               FontSize="{Binding InfoActionFontSize, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                               FontWeight="Medium" Foreground="{DynamicResource PrimaryForegroundSolidColorBrush}"/>
                                </StackPanel>
                            </Border>

                            <StackPanel Margin="0,12,0,0">
                                <Button x:Name="ProjectWebsiteButton"
                                        Style="{StaticResource DetailsExternalLink}"
                                        ToolTip="Открыть в браузере" Click="OnOpenWebsiteClick">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock x:Name="ProjectWebsiteLabel" Text="Перейти на ресурс"
                                                   FontSize="{Binding InfoActionFontSize, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" FontWeight="Medium"
                                                   Foreground="{DynamicResource ActivitySolidColorBrush}"
                                                   VerticalAlignment="Center"/>
                                        <Path Width="13" Height="13" Margin="7,0,0,0"
                                              Stretch="Uniform" VerticalAlignment="Center"
                                              Data="M5,2 L11,2 L11,8 M11,2 L5,8 M10,9 L10,11 L2,11 L2,3 L4,3"
                                              Stroke="{DynamicResource ActivitySolidColorBrush}"
                                              StrokeThickness="1.5" StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                    </StackPanel>
                                </Button>

                                <Button x:Name="PanelDeleteButton" Margin="0,10,0,0" HorizontalAlignment="Left"
                                        Style="{StaticResource DetailsExternalLink}" Click="OnDeleteClick"
                                        ToolTip="Удалить дополнение"
                                        Visibility="{Binding SelectedAddon.IsInstalled, Converter={converters:BooleanToVisibilityConverter}}">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Path Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center"
                                              Data="M4,2 L12,2 M5,2 L5,13 M11,2 L11,13 M3,4 L13,4 M7,2 L7,1 L9,1 L9,2 M6,6 L6,11 M10,6 L10,11 M4,13 L12,13"
                                              Stroke="#F26D6D" StrokeThickness="1.5" StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                        <TextBlock Text="Удалить дополнение" Margin="8,0,0,0"
                                                   FontSize="{Binding InfoActionFontSize, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" FontWeight="Medium"
                                                   Foreground="#F26D6D" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
