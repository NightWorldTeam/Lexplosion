<UserControl x:Class="Lexplosion.UI.WPF.Mvvm.Views.Pages.AddonDetails.AddonDetailsView"
             x:Name="AddonDetailsRoot"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Lexplosion.UI.WPF.Controls"
             xmlns:converters="clr-namespace:Lexplosion.UI.WPF.Core.Converters"
             xmlns:extensions="clr-namespace:Lexplosion.UI.WPF.Extensions"
             xmlns:lexplosion="clr-namespace:Lexplosion;assembly=Lexplosion.Core"
             xmlns:details="clr-namespace:Lexplosion.UI.WPF.Mvvm.Views.Pages.AddonDetails"
             xmlns:addonModels="clr-namespace:Lexplosion.UI.WPF.Mvvm.Models.AddonsRepositories"
             Background="{DynamicResource PageSolidColorBrush}" ClipToBounds="True"
             Loaded="OnLoaded" Unloaded="OnUnloaded">

    <UserControl.Resources>
        <converters:AddonDetailsBreakpointConverter x:Key="Breakpoint" />
        <converters:AddonDetailsContentMarginConverter x:Key="ContentInset" />
        <converters:AddonDetailsSidebarWidthConverter x:Key="SidebarWidth" />

        <!-- The content and header tabs use the same 66/74 DIP horizontal inset. -->
        <Style x:Key="HeaderSurface" TargetType="Border">
            <Setter Property="Padding" Value="24,12,24,12" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType={x:Type details:AddonDetailsView}}, Converter={StaticResource Breakpoint}, ConverterParameter=Compact}" Value="True">
                    <Setter Property="Padding" Value="18,10,18,11" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="HeaderLogo" TargetType="Border">
            <Setter Property="Width" Value="64" />
            <Setter Property="Height" Value="64" />
            <Setter Property="Margin" Value="14,0,16,0" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType={x:Type details:AddonDetailsView}}, Converter={StaticResource Breakpoint}, ConverterParameter=Compact}" Value="True">
                    <Setter Property="Width" Value="54" />
                    <Setter Property="Height" Value="54" />
                    <Setter Property="Margin" Value="12,0,14,0" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="HeaderTitle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="22" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType={x:Type details:AddonDetailsView}}, Converter={StaticResource Breakpoint}, ConverterParameter=Compact}" Value="True">
                    <Setter Property="FontSize" Value="19" />
                </DataTrigger>
                <DataTrigger Binding="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType={x:Type details:AddonDetailsView}}, Converter={StaticResource Breakpoint}, ConverterParameter=ExtraWide}" Value="True">
                    <Setter Property="FontSize" Value="24" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Only page-specific typography and adaptive behavior. The controls use
             the launcher-wide AdvancedButton and TextBlock styles. -->
        <Style x:Key="InfoCaption" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="Foreground" Value="{DynamicResource SecondaryForegroundSolidColorBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,0,0,7" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType={x:Type details:AddonDetailsView}}, Converter={StaticResource Breakpoint}, ConverterParameter=Large}" Value="True">
                    <Setter Property="FontSize" Value="14" />
                </DataTrigger>
                <DataTrigger Binding="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType={x:Type details:AddonDetailsView}}, Converter={StaticResource Breakpoint}, ConverterParameter=ExtraLarge}" Value="True">
                    <Setter Property="FontSize" Value="15" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="InfoValue" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundSolidColorBrush}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType={x:Type details:AddonDetailsView}}, Converter={StaticResource Breakpoint}, ConverterParameter=Large}" Value="True">
                    <Setter Property="FontSize" Value="16" />
                </DataTrigger>
                <DataTrigger Binding="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType={x:Type details:AddonDetailsView}}, Converter={StaticResource Breakpoint}, ConverterParameter=ExtraLarge}" Value="True">
                    <Setter Property="FontSize" Value="17" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="InfoSeparator" TargetType="Border">
            <Setter Property="Height" Value="1" />
            <Setter Property="Margin" Value="0,18,0,18" />
            <Setter Property="Background" Value="{DynamicResource SeparateSolidColorBrush}" />
        </Style>
        <DataTemplate x:Key="InfoChip">
            <Border Background="{DynamicResource LayoutTabSolidColorBrush}"
                    BorderBrush="{DynamicResource SeparateSolidColorBrush}"
                    BorderThickness="1" CornerRadius="6" Margin="0,0,8,8" Padding="9,6">
                <TextBlock Text="{Binding}" Style="{StaticResource InfoCaption}" Margin="0"
                           Foreground="{DynamicResource PrimaryForegroundSolidColorBrush}" />
            </Border>
        </DataTemplate>
        <Style x:Key="MetadataToggle" TargetType="ToggleButton">
            <Setter Property="Height" Value="28" />
            <Setter Property="Margin" Value="0,4,0,0" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource ActivitySolidColorBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="{TemplateBinding Background}" Padding="0,4">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="Label" Text="{DynamicResource More}" FontSize="14"
                                           Foreground="{TemplateBinding Foreground}" />
                                <TextBlock x:Name="Count" FontSize="14" Foreground="{TemplateBinding Foreground}"
                                           Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}, StringFormat=' (+{0})'}" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Label" Property="Text" Value="{DynamicResource ShowLess}" />
                                <Setter TargetName="Count" Property="Visibility" Value="Collapsed" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource DefaultButtonHoverBackgroundColorBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SidebarPanel" TargetType="Border">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Model.IsInformationOpen}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType={x:Type details:AddonDetailsView}}, Converter={StaticResource Breakpoint}, ConverterParameter=Wide}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SidebarScrim" TargetType="Border">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Model.IsInformationOpen}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType={x:Type details:AddonDetailsView}}, Converter={StaticResource Breakpoint}, ConverterParameter=Wide}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SidebarToggle" TargetType="controls:AdvancedButton" BasedOn="{StaticResource sm-default}">
            <Setter Property="Visibility" Value="Visible" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType={x:Type details:AddonDetailsView}}, Converter={StaticResource Breakpoint}, ConverterParameter=Wide}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SidebarClose" TargetType="controls:AdvancedButton" BasedOn="{StaticResource sm-button-icon}">
            <Setter Property="FontSize" Value="18" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType={x:Type details:AddonDetailsView}}, Converter={StaticResource Breakpoint}, ConverterParameter=Wide}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Background="{DynamicResource PageSolidColorBrush}">
        <Grid.RowDefinitions>
            <!-- MainWindow's 40 DIP WindowHeaderContainer overlays pages. -->
            <RowDefinition Height="40" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 1. Шапка: назад, иконка, название, установка / удаление -->
        <Border Grid.Row="1" Background="{DynamicResource LayoutTabSolidColorBrush}"
                BorderBrush="{DynamicResource LayoutTabBorderSolidColorBrush}" BorderThickness="0,0,0,1"
                Style="{StaticResource HeaderSurface}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <controls:AdvancedButton Grid.Column="0" Width="36" Height="32" VerticalAlignment="Top"
                                         Style="{StaticResource sm-button-icon}" Background="Transparent"
                                         Foreground="{DynamicResource PrimaryForegroundSolidColorBrush}"
                                         FontSize="19" IconData="{StaticResource PDLeftBackArrow}"
                                         ToolTip="{DynamicResource AddonDetailsBack}" Command="{Binding CloseAddonDetailsCommand}" />
                <Border Grid.Column="1" Style="{StaticResource HeaderLogo}" CornerRadius="11"
                        Background="{Binding Model.Addon.Logo, Converter={converters:ImageSourceNullValidateConverter}}" />
                <StackPanel Grid.Column="2" Margin="0,0,18,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Model.Addon.Name}" ToolTip="{Binding Model.Addon.Name}"
                               Style="{StaticResource HeaderTitle}" FontWeight="SemiBold"
                               Foreground="{DynamicResource PrimaryForegroundSolidColorBrush}"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Model.Addon.Description}" ToolTip="{Binding Model.Addon.Description}"
                               Margin="0,4,0,0" FontSize="12" TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource SecondaryForegroundSolidColorBrush}" />
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <TextBlock Text="{Binding Model.Addon.Author}" FontSize="12"
                                   Foreground="{DynamicResource SecondaryForegroundSolidColorBrush}" />
                        <TextBlock Text=" · " FontSize="12" Foreground="{DynamicResource SecondaryForegroundSolidColorBrush}" />
                        <TextBlock Text="{Binding Model.Addon.DownloadCount, StringFormat='{}{0:N0}'}" FontSize="12"
                                   Foreground="{DynamicResource SecondaryForegroundSolidColorBrush}" />
                        <TextBlock Text="{DynamicResource AddonDetailsDownloads}" Margin="4,0,0,0" FontSize="12"
                                   Foreground="{DynamicResource SecondaryForegroundSolidColorBrush}" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <controls:AdvancedButton Height="32" MinWidth="110" Margin="0,0,8,0"
                                             Command="{Binding InstallAddonCommand}" CommandParameter="{Binding Model.Addon}">
                        <controls:AdvancedButton.Style>
                            <Style TargetType="controls:AdvancedButton" BasedOn="{StaticResource sm-default}">
                                <Setter Property="Content" Value="{DynamicResource AddonDetailsInstall}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Model.Addon.IsInstalled}" Value="True">
                                        <Setter Property="Content" Value="{DynamicResource AddonDetailsInstalled}" />
                                        <Setter Property="IsEnabled" Value="False" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Model.Addon.UpdateAvailable}" Value="True">
                                        <Setter Property="Content" Value="{DynamicResource AddonDetailsUpdate}" />
                                        <Setter Property="IsEnabled" Value="True" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Model.Addon.IsLoading}" Value="True">
                                        <Setter Property="IsEnabled" Value="False" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </controls:AdvancedButton.Style>
                    </controls:AdvancedButton>
                    <controls:AdvancedButton Style="{StaticResource sm-ghost}" Margin="0,0,8,0"
                                             IconData="{StaticResource PDDelete}" Text="{DynamicResource AddonDetailsDelete}"
                                             ToolTip="{DynamicResource AddonDetailsRemove}"
                                             Command="{Binding UninstallAddonCommand}" CommandParameter="{Binding Model.Addon}"
                                             Visibility="{Binding Model.Addon.IsInstalled, Converter={converters:BooleanToVisibilityConverter}}" />
                    <controls:AdvancedButton Width="32" Height="32" Content="i" FontSize="16" FontWeight="Bold"
                                             Style="{StaticResource SidebarToggle}" ToolTip="{DynamicResource AddonDetailsAbout}"
                                             Command="{Binding ToggleInformationCommand}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. Вкладки + их содержимое. Одна колонка для описания / галереи / версий. -->
        <Grid Grid.Row="2" ClipToBounds="True">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition>
                    <ColumnDefinition.Width>
                        <MultiBinding Converter="{StaticResource SidebarWidth}">
                            <Binding ElementName="AddonDetailsRoot" Path="ActualWidth" />
                            <Binding Path="DataContext.Model.IsInformationOpen" ElementName="AddonDetailsRoot" />
                        </MultiBinding>
                    </ColumnDefinition.Width>
                </ColumnDefinition>
            </Grid.ColumnDefinitions>

            <controls:UIUnderlineTabControl x:Name="DetailsTabs" Grid.Column="0"
                        Background="{DynamicResource PageSolidColorBrush}"
                        BorderBrush="{DynamicResource SeparateSolidColorBrush}"
                        EnableAnimations="False"
                        ItemContainerStyle="{StaticResource UITabItem}"
                        TabPanelPadding="{Binding ActualWidth, ElementName=AddonDetailsRoot, Converter={StaticResource ContentInset}}"
                        SelectedIndex="{Binding Model.SelectedTabIndex, Mode=TwoWay}">
                <TabItem Header="AddonDetailsDescription">
                    <Grid x:Name="DescriptionHost" Background="{DynamicResource PageSolidColorBrush}" ClipToBounds="True">
                        <Grid x:Name="BrowserHost" Background="{DynamicResource PageSolidColorBrush}"
                              Margin="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType={x:Type details:AddonDetailsView}}, Converter={StaticResource ContentInset}, ConverterParameter=Browser}" />
                        <Grid x:Name="LoadingOverlay" Background="{DynamicResource PageSolidColorBrush}" IsHitTestVisible="False">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <controls:CircleLoader x:Name="LoadingBar" Width="36" Height="36" Background="Transparent" IsActive="True" />
                                <TextBlock x:Name="LoadingText" Text="{DynamicResource AddonDetailsDescriptionLoading}"
                                           Margin="0,14,0,0" HorizontalAlignment="Center" TextWrapping="Wrap"
                                           Foreground="{DynamicResource SecondaryForegroundSolidColorBrush}" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </TabItem>
                <TabItem Header="AddonDetailsGallery">
                    <Grid>
                        <ScrollViewer Background="{DynamicResource PageSolidColorBrush}" HorizontalScrollBarVisibility="Disabled"
                                      VerticalScrollBarVisibility="Auto" Visibility="{Binding Model.HasGallery, Converter={converters:BooleanToVisibilityConverter}}">
                            <ItemsControl Margin="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType={x:Type details:AddonDetailsView}}, Converter={StaticResource ContentInset}, ConverterParameter=Gallery}"
                                          MaxWidth="1140" ItemsSource="{Binding Model.PageData.Images}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource LayoutTabSolidColorBrush}" BorderBrush="{DynamicResource SeparateSolidColorBrush}"
                                                BorderThickness="1" CornerRadius="10" Padding="10" Margin="0,0,0,16">
                                            <Image Source="{Binding}" Stretch="Uniform" MaxHeight="550" />
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Visibility="{Binding Model.HasGallery, Converter={converters:NegativeBooleanToVisibilityConverter}}">
                            <controls:CircleLoader Width="36" Height="36" Background="Transparent">
                                <controls:CircleLoader.Style>
                                    <Style TargetType="{x:Type controls:CircleLoader}" BasedOn="{StaticResource {x:Type controls:CircleLoader}}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Model.IsPageLoaded}" Value="False">
                                                <Setter Property="IsActive" Value="True" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </controls:CircleLoader.Style>
                            </controls:CircleLoader>
                            <TextBlock Margin="0,14" TextAlignment="Center" Foreground="{DynamicResource SecondaryForegroundSolidColorBrush}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="{DynamicResource AddonDetailsGalleryLoading}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Model.IsPageLoaded}" Value="True">
                                                <Setter Property="Text" Value="{DynamicResource AddonDetailsGalleryEmpty}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Model.IsPageLoadFailed}" Value="True">
                                                <Setter Property="Text" Value="{DynamicResource AddonDetailsGalleryError}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Grid>
                </TabItem>
                <TabItem Header="AddonDetailsVersions">
                    <Grid Margin="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType={x:Type details:AddonDetailsView}}, Converter={StaticResource ContentInset}, ConverterParameter=Versions}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock x:Name="VersionsStatus" Margin="0,0,0,14"
                                   Foreground="{DynamicResource SecondaryForegroundSolidColorBrush}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="{DynamicResource AddonDetailsVersionsHint}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Model.VersionsState}" Value="{x:Static addonModels:AddonVersionsState.Loading}">
                                            <Setter Property="Text" Value="{DynamicResource AddonDetailsVersionsLoading}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Model.VersionsState}" Value="{x:Static addonModels:AddonVersionsState.Ready}">
                                            <Setter Property="Text" Value="{DynamicResource AddonDetailsVersionsSelect}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Model.VersionsState}" Value="{x:Static addonModels:AddonVersionsState.Empty}">
                                            <Setter Property="Text" Value="{DynamicResource AddonDetailsVersionsEmpty}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Model.VersionsState}" Value="{x:Static addonModels:AddonVersionsState.Error}">
                                            <Setter Property="Text" Value="{Binding Model.VersionsError}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <ListBox x:Name="VersionsList" Grid.Row="1"
                                 ItemsSource="{Binding Model.Versions}" SelectedItem="{Binding Model.SelectedVersion, Mode=TwoWay}"
                                 Style="{StaticResource TransparentListBox}" VirtualizingPanel.ScrollUnit="Pixel">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="{x:Type ListBoxItem}" BasedOn="{StaticResource DefaultListBoxItem}">
                                    <Setter Property="Padding" Value="12,9" />
                                    <Setter Property="BorderThickness" Value="1" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock FontSize="14" FontWeight="Medium" Foreground="{DynamicResource PrimaryForegroundSolidColorBrush}"
                                               Text="{Binding Converter={converters:ToStringConverter}}" TextTrimming="CharacterEllipsis" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <controls:CircleLoader Grid.Row="1" Width="36" Height="36" Background="Transparent"
                                               HorizontalAlignment="Center" VerticalAlignment="Center">
                            <controls:CircleLoader.Style>
                                <Style TargetType="{x:Type controls:CircleLoader}" BasedOn="{StaticResource {x:Type controls:CircleLoader}}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Model.VersionsState}" Value="{x:Static addonModels:AddonVersionsState.Loading}">
                                            <Setter Property="IsActive" Value="True" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </controls:CircleLoader.Style>
                        </controls:CircleLoader>
                        <controls:AdvancedButton x:Name="InstallVersionButton" Grid.Row="2" Height="32" MinWidth="208"
                                                 Margin="0,16,0,0" HorizontalAlignment="Right"
                                                 Content="{DynamicResource AddonDetailsInstallVersion}"
                                                 Style="{StaticResource sm-default}" Command="{Binding InstallSelectedAddonVersionCommand}"
                                                  
                                                 IsEnabled="{Binding Model.CanInstallSelectedVersion}" />
                    </Grid>
                </TabItem>
            </controls:UIUnderlineTabControl>

            <!-- A separate WebView2 column prevents sidebar overlap; scrim is for compact drawer mode. -->
            <Border Grid.Column="0" Background="#96000000" Cursor="Hand"
                    Style="{StaticResource SidebarScrim}" MouseLeftButtonUp="OnInformationScrimClick" />

            <!-- 3. Правая панель -->
            <Border Grid.Column="1" Style="{StaticResource SidebarPanel}"
                    Background="{DynamicResource PrimarySolidColorBrush}" ClipToBounds="True"
                    BorderBrush="{DynamicResource SeparateSolidColorBrush}" BorderThickness="1,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <DockPanel Margin="24,16,18,14">
                        <controls:AdvancedButton DockPanel.Dock="Right" Width="32" Height="32"
                                                 Style="{StaticResource SidebarClose}" IconData="{StaticResource PDClose}"
                                                 ToolTip="{DynamicResource Close}" Command="{Binding CloseInformationCommand}" />
                        <TextBlock Text="{DynamicResource AddonDetailsAbout}" FontSize="18" FontWeight="SemiBold"
                                   VerticalAlignment="Center" Foreground="{DynamicResource PrimaryForegroundSolidColorBrush}" />
                    </DockPanel>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="24,6,22,30">
                            <TextBlock Style="{StaticResource InfoCaption}" Text="{DynamicResource AddonDetailsAuthor}" />
                            <TextBlock Style="{StaticResource InfoValue}" Text="{Binding Model.Addon.Author}" />
                            <Border Style="{StaticResource InfoSeparator}" />
                            <TextBlock Style="{StaticResource InfoCaption}" Text="{DynamicResource AddonDetailsUpdated}" />
                            <TextBlock Style="{StaticResource InfoValue}" Text="{Binding Model.Addon.LastUpdated, TargetNullValue=—, FallbackValue=—}" />
                            <Border Style="{StaticResource InfoSeparator}" />
                            <TextBlock Style="{StaticResource InfoCaption}" Text="{DynamicResource AddonDetailsMinecraftVersions}" />
                            <ItemsControl x:Name="MinecraftVersionsItems" ItemTemplate="{StaticResource InfoChip}" ItemsSource="{Binding Model.PageData.VisibleMinecraftVersions}">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            </ItemsControl>
                            <ItemsControl x:Name="MinecraftVersionsOverflow" ItemTemplate="{StaticResource InfoChip}" ItemsSource="{Binding Model.PageData.MoreMinecraftVersions}"
                                          Visibility="{Binding IsChecked, ElementName=MoreMinecraftVersionsButton, Converter={converters:BooleanToVisibilityConverter}}">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            </ItemsControl>
                            <ToggleButton x:Name="MoreMinecraftVersionsButton" AutomationProperties.AutomationId="addon.details.more.minecraft-versions"
                                          Style="{StaticResource MetadataToggle}" Tag="{Binding Items.Count, ElementName=MinecraftVersionsOverflow}"
                                          Visibility="{Binding HasItems, ElementName=MinecraftVersionsOverflow, Converter={converters:BooleanToVisibilityConverter}}" />
                            <Border Style="{StaticResource InfoSeparator}" />
                            <TextBlock Style="{StaticResource InfoCaption}" Text="{DynamicResource AddonDetailsLoaders}" />
                            <ItemsControl x:Name="ModloadersItems" ItemTemplate="{StaticResource InfoChip}" ItemsSource="{Binding Model.PageData.VisibleModloaders}">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            </ItemsControl>
                            <ItemsControl x:Name="ModloadersOverflow" ItemTemplate="{StaticResource InfoChip}" ItemsSource="{Binding Model.PageData.MoreModloaders}"
                                          Visibility="{Binding IsChecked, ElementName=MoreModloadersButton, Converter={converters:BooleanToVisibilityConverter}}">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            </ItemsControl>
                            <ToggleButton x:Name="MoreModloadersButton" AutomationProperties.AutomationId="addon.details.more.modloaders"
                                          Style="{StaticResource MetadataToggle}" Tag="{Binding Items.Count, ElementName=ModloadersOverflow}"
                                          Visibility="{Binding HasItems, ElementName=ModloadersOverflow, Converter={converters:BooleanToVisibilityConverter}}" />
                            <Border Style="{StaticResource InfoSeparator}" />
                            <TextBlock Style="{StaticResource InfoCaption}" Text="{DynamicResource AddonDetailsCategories}" />
                            <ItemsControl x:Name="CategoryItems" ItemTemplate="{StaticResource InfoChip}" ItemsSource="{Binding Model.PageData.VisibleCategories}">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            </ItemsControl>
                            <ItemsControl x:Name="CategoriesOverflow" ItemTemplate="{StaticResource InfoChip}" ItemsSource="{Binding Model.PageData.MoreCategories}"
                                          Visibility="{Binding IsChecked, ElementName=MoreCategoriesButton, Converter={converters:BooleanToVisibilityConverter}}">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            </ItemsControl>
                            <ToggleButton x:Name="MoreCategoriesButton" AutomationProperties.AutomationId="addon.details.more.categories"
                                          Style="{StaticResource MetadataToggle}" Tag="{Binding Items.Count, ElementName=CategoriesOverflow}"
                                          Visibility="{Binding HasItems, ElementName=CategoriesOverflow, Converter={converters:BooleanToVisibilityConverter}}" />
                            <Border Style="{StaticResource InfoSeparator}" />
                            <TextBlock Style="{StaticResource InfoCaption}" Text="{DynamicResource AddonDetailsSource}" />
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <Path Width="22" Height="22" Stretch="Uniform">
                                    <Path.Style>
                                        <Style TargetType="Path">
                                            <Setter Property="extensions:PathExtensions.StringData" Value="{StaticResource PDModrinth}" />
                                            <Setter Property="Fill" Value="#1BD96A" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Model.Addon.Source}" Value="{x:Static lexplosion:ProjectSource.Curseforge}">
                                                    <Setter Property="extensions:PathExtensions.StringData" Value="{StaticResource PDCurseforge}" />
                                                    <Setter Property="Fill" Value="#F16436" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Path.Style>
                                </Path>
                                <TextBlock Margin="9,0,0,0" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource InfoValue}">
                                            <Setter Property="Text" Value="Modrinth" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Model.Addon.Source}" Value="{x:Static lexplosion:ProjectSource.Curseforge}">
                                                    <Setter Property="Text" Value="CurseForge" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                            <controls:AdvancedButton x:Name="ProjectWebsiteButton" Height="32"
                                                     HorizontalAlignment="Left" Foreground="{DynamicResource ActivitySolidColorBrush}"
                                                     Command="{Binding OpenExternalResourceCommand}" CommandParameter="{Binding Model.Addon}"
                                                     ToolTip="{DynamicResource AddonDetailsOpenWebsite}">
                                <controls:AdvancedButton.Style>
                                    <Style TargetType="controls:AdvancedButton" BasedOn="{StaticResource TransparentAdvancedButton}">
                                        <Setter Property="IconData" Value="{StaticResource PDModrinth}" />
                                        <Setter Property="Text" Value="{DynamicResource AddonDetailsVisitModrinth}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Model.Addon.Source}" Value="{x:Static lexplosion:ProjectSource.Curseforge}">
                                                <Setter Property="IconData" Value="{StaticResource PDCurseforge}" />
                                                <Setter Property="Text" Value="{DynamicResource AddonDetailsVisitCurseForge}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </controls:AdvancedButton.Style>
                            </controls:AdvancedButton>
                            <controls:AdvancedButton Margin="0,6,0,0" Height="32" HorizontalAlignment="Left"
                                                     Style="{StaticResource TransparentAdvancedButton}" Foreground="#F26D6D"
                                                     IconData="{StaticResource PDDelete}" Text="{DynamicResource AddonDetailsRemove}"
                                                     Command="{Binding UninstallAddonCommand}" CommandParameter="{Binding Model.Addon}"
                                                     Visibility="{Binding Model.Addon.IsInstalled, Converter={converters:BooleanToVisibilityConverter}}" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
