<UserControl
    x:Class="Lexplosion.UI.WPF.Mvvm.Views.Pages.MainContent.MainMenu.MainMenuLayoutView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:Lexplosion.UI.WPF.Core.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Lexplosion.UI.WPF.Mvvm.ViewModels.MainContent.MainMenu"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:news="clr-namespace:Lexplosion.UI.WPF.ViewComponents.News"
    d:DataContext="{d:DesignInstance Type=local:MainMenuLayoutViewModel}"
    d:DesignHeight="528"
    d:DesignWidth="944"
    Loaded="MainMenuLayoutView_Loaded"
    Unloaded="MainMenuLayoutView_Unloaded"
    SizeChanged="MainMenuLayoutView_SizeChanged"
    DataContextChanged="MainMenuLayoutView_DataContextChanged"
    mc:Ignorable="d">
    <Grid
        Background="{DynamicResource PageSolidColorBrush}"
        MouseDown="Grid_MouseDown">

        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="LeftPanelColumn" Width="0.363*" MaxWidth="350" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <ContentControl Content="{Binding LeftPanel}" KeyboardNavigation.IsTabStop="False" />

        <!-- Compact/regular launcher content. v11 keeps its already-created visual tree
             cached while Home is visible instead of destroying it at the breakpoint. -->
        <ContentControl
            x:Name="SectionContentHost"
            Grid.Column="1"
            KeyboardNavigation.IsTabStop="False"
            KeyboardNavigation.TabNavigation="None" />

        <!-- Responsive Home. The HomeView instance is created/premeasured at idle by
             code-behind and placed here while this host is Collapsed. Crossing the
             breakpoint therefore becomes only a Visibility swap. -->
        <ContentControl
            x:Name="ResponsiveHomeHost"
            Grid.Column="1"
            Visibility="Collapsed" />

        <!-- Latest News View -->
        <news:LatestNewsView
            Grid.ColumnSpan="2"
            DataContext="{Binding LatestNewsViewModel}"
            Visibility="{Binding Model.HasUnseenNews, UpdateSourceTrigger=PropertyChanged, Converter={converters:BooleanToVisibilityConverter}}" />
    </Grid>
</UserControl>
