<UserControl
    x:Class="Lexplosion.UI.WPF.Mvvm.Views.Pages.MainContent.MainMenu.LeftPanel.Components.AccountSidebarMenuView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:accounts="clr-namespace:Lexplosion.Logic.Management.Accounts;assembly=Lexplosion.Core"
    xmlns:controls="clr-namespace:Lexplosion.UI.WPF.Controls"
    xmlns:core="clr-namespace:Lexplosion.UI.WPF.Core"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:enums="clr-namespace:Lexplosion;assembly=Lexplosion.Core"
    xmlns:extensions="clr-namespace:Lexplosion.UI.WPF.Extensions"
    xmlns:local="clr-namespace:Lexplosion.UI.WPF.Mvvm.Views.Pages.MainContent.MainMenu.LeftPanel.Components"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">

    <UserControl.Resources>
        <core:BindingProxy x:Key="CurrentViewModel" Data="{Binding}" />

        <Style
            x:Key="AccountSidebarButton"
            BasedOn="{StaticResource {x:Type controls:AdvancedButton}}"
            TargetType="{x:Type controls:AdvancedButton}">
            <Setter Property="Height" Value="32" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource SecondaryForegroundSolidColorBrush}" />
            <Setter Property="TextPadding" Value="4,0,0,0" />
            <Setter Property="IconPadding" Value="4" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="CornerRadius" Value="5" />

            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SecondarySolidColorBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundSolidColorBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <DataTemplate DataType="{x:Type accounts:Account}">
            <RadioButton
                Command="{Binding Data.SelectAccountCommand, Source={StaticResource CurrentViewModel}}"
                CommandParameter="{Binding}"
                GroupName="SidebarAccounts">
                <RadioButton.Template>
                    <ControlTemplate TargetType="{x:Type RadioButton}">
                        <Border
                            x:Name="Body"
                            Height="48"
                            Padding="3,4,8,4"
                            Background="Transparent"
                            CornerRadius="5">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Border Width="32" Height="32">
                                    <Border.Background>
                                        <ImageBrush ImageSource="{Binding HeadImageUrl}" />
                                    </Border.Background>
                                </Border>

                                <StackPanel Grid.Column="1" Margin="8,0,0,0">

                                    <TextBlock
                                        FontSize="13"
                                        FontWeight="Medium"
                                        Foreground="{DynamicResource PrimaryForegroundSolidColorBrush}"
                                        Text="{Binding Login}" />

                                    <StackPanel Orientation="Horizontal">

                                        <Border>
                                            <Border.Style>
                                                <Style TargetType="{x:Type Border}">
                                                    <Setter Property="Margin" Value="0,0,4,0" />
                                                    <Setter Property="Width" Value="14" />
                                                    <Setter Property="Height" Value="14" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding AccountType}" Value="{x:Static enums:AccountType.NoAuth}">
                                                            <Setter Property="Margin" Value="0" />
                                                            <Setter Property="Width" Value="0" />
                                                            <Setter Property="Height" Value="0" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding AccountType}" Value="{x:Static enums:AccountType.Microsoft}">
                                                            <Setter Property="Background">
                                                                <Setter.Value>
                                                                    <ImageBrush ImageSource="pack://Application:,,,/Assets/images/icons/microsoft.png" />
                                                                </Setter.Value>
                                                            </Setter>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding AccountType}" Value="{x:Static enums:AccountType.NightWorld}">
                                                            <Setter Property="Background">
                                                                <Setter.Value>
                                                                    <ImageBrush ImageSource="pack://Application:,,,/Assets/images/icons/nightworld.png" />
                                                                </Setter.Value>
                                                            </Setter>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                        </Border>

                                        <TextBlock
                                            extensions:TextBlockExtensions.TextByKey="{Binding AccountType}"
                                            FontSize="12"
                                            Foreground="{DynamicResource SecondaryForegroundSolidColorBrush}" />
                                    </StackPanel>
                                </StackPanel>

                                <Ellipse
                                    x:Name="RadioButtonBullet"
                                    Grid.Column="2"
                                    Width="14"
                                    Height="14"
                                    Margin="0,3,0,0"
                                    VerticalAlignment="Top"
                                    Stroke="{DynamicResource SeparateSolidColorBrush}"
                                    StrokeThickness="2" />
                            </Grid>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Body" Property="Background" Value="{DynamicResource SecondarySolidColorBrush}" />
                                <Setter TargetName="RadioButtonBullet" Property="Stroke" Value="{DynamicResource PrimaryForegroundSolidColorBrush}" />

                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation
                                                Storyboard.TargetName="RadioButtonBullet"
                                                Storyboard.TargetProperty="StrokeThickness"
                                                To="4"
                                                Duration="0:0:0.35" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation
                                                Storyboard.TargetName="RadioButtonBullet"
                                                Storyboard.TargetProperty="StrokeThickness"
                                                To="2"
                                                Duration="0:0:0.35" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </RadioButton.Template>
            </RadioButton>
        </DataTemplate>
    </UserControl.Resources>

    <Border
        MinWidth="250"
        Padding="8,4"
        Background="{DynamicResource PrimarySolidColorBrush}"
        BorderBrush="{DynamicResource SeparateSolidColorBrush}"
        BorderThickness="2"
        CornerRadius="5">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!--  Button  -->
            <StackPanel Margin="0,0,0,8">
                <controls:AdvancedButton
                    Command="{Binding ViewProfileCommand}"
                    IconData="{DynamicResource PDProfile}"
                    Style="{StaticResource AccountSidebarButton}"
                    Text="View Profile" />
                <controls:AdvancedButton
                    Command="{Binding ViewProfileSettingsCommand}"
                    IconData="{DynamicResource PDSettings}"
                    Style="{StaticResource AccountSidebarButton}"
                    Text="Account Settings" />
                <controls:AdvancedButton
                    IconData="{DynamicResource PDCatalog}"
                    Style="{StaticResource AccountSidebarButton}"
                    Text="Documentation" />
            </StackPanel>

            <!--  Accounts  -->
            <Border
                Grid.Row="1"
                Margin="-8,0"
                Padding="12,8"
                BorderBrush="{DynamicResource SeparateSolidColorBrush}"
                BorderThickness="0,2,0,0">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock
                        FontSize="11"
                        FontWeight="Medium"
                        Foreground="{DynamicResource SecondaryForegroundSolidColorBrush}"
                        Text="Switch Account" />

                    <ListBox
                        Grid.Row="1"
                        Height="100"
                        Margin="-3,0,-13,0"
                        ItemsSource="{x:Static accounts:Account.List}"
                        Style="{StaticResource TransparentListBox}"
                        VirtualizingPanel.ScrollUnit="Pixel" />

                    <controls:AdvancedButton />
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
