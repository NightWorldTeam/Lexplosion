<UserControl
    x:Class="Lexplosion.UI.WPF.Mvvm.Views.Pages.MainContent.MainMenu.LeftPanel.Components.MainMenuLeftPanelHeaderView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Lexplosion.UI.WPF.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:enums="clr-namespace:Lexplosion;assembly=Lexplosion.Core"
    xmlns:local="clr-namespace:Lexplosion.UI.WPF.Mvvm.Views.Pages.MainContent.MainMenu.LeftPanel.Components"
    xmlns:mainmenu="clr-namespace:Lexplosion.UI.WPF.Mvvm.ViewModels.MainContent.MainMenu"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:valueconverters="clr-namespace:Lexplosion.UI.WPF.Core.Converters"
    d:DataContext="{d:DesignInstance Type=mainmenu:LeftPanelViewModel}"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <Grid
        x:Name="Root"
        Height="80"
        Margin="0,32,0,0"
        Background="Transparent">

        <Grid
            x:Name="Header"
            HorizontalAlignment="Stretch"
            Background="Transparent">
            <Border
                Padding="20"
                BorderBrush="{DynamicResource SeparateSolidColorBrush}"
                BorderThickness="1"
                CornerRadius="5">

                <Border.Style>
                    <Style TargetType="{x:Type Border}">
                        <Setter Property="Background" Value="{DynamicResource SecondarySolidColorBrush}" />
                        <Style.Triggers>

                            <DataTrigger Binding="{Binding ProfileBanner.Url, Converter={valueconverters:IsValueNullConverter}}" Value="False">
                                <Setter Property="Background" Value="{Binding ProfileBanner.Url, Converter={valueconverters:ImageSourceNullValidateConverter}, ConverterParameter={x:Static Stretch.UniformToFill}}" />
                            </DataTrigger>

                            <DataTrigger Binding="{Binding ElementName=Toggle, Path=IsMouseOver}" Value="True">
                                <Setter Property="Opacity" Value="0.9" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                
                <Grid ShowGridLines="True">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!--  Avatar  -->

                    <Border
                        Width="40"
                        Height="40"
                        BorderBrush="{DynamicResource SeparateSolidColorBrush}"
                        BorderThickness="1"
                        CornerRadius="5">
                        <Border.Background>
                            <ImageBrush ImageSource="pack://Application:,,,/Assets/images/icons/non_image.png" />
                        </Border.Background>
                    </Border>

                    <Border
                        x:Name="LogoBorder"
                        Width="40"
                        Height="40"
                        Background="{Binding UserAvatar, Converter={valueconverters:ImageSourceNullValidateConverter}}"
                        CornerRadius="5" />

                    <controls:CircleLoader
                        Width="40"
                        Height="40"
                        Padding="8"
                        VerticalAlignment="Center"
                        BlurTarget="{Binding ElementName=LogoBorder}"
                        CornerRadius="5"
                        IconHeight="12"
                        IconWidth="12"
                        IsActive="{Binding UserAvatar, Converter={valueconverters:IsStringNullOrEmptyConverter}}">
                        <controls:CircleLoader.Background>
                            <SolidColorBrush Opacity="0.8" Color="Black" />
                        </controls:CircleLoader.Background>
                    </controls:CircleLoader>

                    <Grid Grid.Column="1" Margin="10,0,0,0">
                        <!--  Glad to see you text  -->
                        <TextBlock
                            x:Name="GladToSeeYouText"
                            VerticalAlignment="Top"
                            FontSize="12"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource SecondaryForegroundSolidColorBrush}"
                            Text="{DynamicResource GladToSeeYou}" />
                        <StackPanel VerticalAlignment="Bottom" Orientation="Horizontal">
                            <Border
                                Width="16"
                                Height="16"
                                Margin="0,8,8,0">
                                <Border.Style>
                                    <Style TargetType="{x:Type Border}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding UserAccountType}" Value="{x:Static enums:AccountType.Microsoft}">
                                                <Setter Property="Visibility" Value="Visible" />
                                                <Setter Property="Background">
                                                    <Setter.Value>
                                                        <ImageBrush ImageSource="pack://Application:,,,/Assets/images/icons/microsoft.png" />
                                                    </Setter.Value>
                                                </Setter>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding UserAccountType}" Value="{x:Static enums:AccountType.NightWorld}">
                                                <Setter Property="Visibility" Value="Visible" />
                                                <Setter Property="Background">
                                                    <Setter.Value>
                                                        <ImageBrush ImageSource="pack://Application:,,,/Assets/images/icons/nightworld.png" />
                                                    </Setter.Value>
                                                </Setter>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border>

                            <TextBlock
                                x:Name="UserNickname"
                                Margin="0,4,0,0"
                                FontSize="16"
                                FontWeight="Medium"
                                Foreground="{DynamicResource PrimaryForegroundSolidColorBrush}"
                                Text="{Binding UserLogin}" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <ToggleButton
            x:Name="Toggle"
            Width="{Binding ActualWidth, ElementName=Root}"
            Height="{Binding ActualHeight, ElementName=Root}"
            Checked="Toggle_Checked"
            Cursor="Hand">
            <ToggleButton.Template>
                <ControlTemplate>
                    <Grid Background="Transparent" />
                </ControlTemplate>
            </ToggleButton.Template>
        </ToggleButton>

        <Popup
            x:Name="SidebarHeaderPopupMenu"
            AllowsTransparency="True"
            HorizontalOffset="5"
            IsOpen="{Binding IsChecked, ElementName=Toggle, Mode=OneWay}"
            Placement="Right"
            StaysOpen="False">
            <local:AccountSidebarMenuView />
        </Popup>
    </Grid>
</UserControl>
