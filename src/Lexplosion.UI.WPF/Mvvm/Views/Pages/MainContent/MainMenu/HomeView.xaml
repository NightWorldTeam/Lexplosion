<UserControl
    x:Class="Lexplosion.UI.WPF.Mvvm.Views.Pages.MainContent.MainMenu.HomeView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Lexplosion.UI.WPF.Controls"
    xmlns:converters="clr-namespace:Lexplosion.UI.WPF.Core.Converters"
    xmlns:core="clr-namespace:Lexplosion.UI.WPF.Core"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:extensions="clr-namespace:Lexplosion.UI.WPF.Extensions"
    xmlns:instanceModel="clr-namespace:Lexplosion.UI.WPF.Mvvm.Models.Mvvm.InstanceModel"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:media="clr-namespace:System.Windows.Media;assembly=PresentationCore"
    xmlns:objects="clr-namespace:Lexplosion.Logic.Objects;assembly=Lexplosion.Core"
    xmlns:oldinstanceform="clr-namespace:Lexplosion.UI.WPF.Controls.OldInstanceForm"
    xmlns:virtualization="clr-namespace:WpfToolkit.Controls;assembly=VirtualizingWrapPanel"
    xmlns:vm="clr-namespace:Lexplosion.UI.WPF.Mvvm.ViewModels.MainContent.MainMenu"
    d:DataContext="{d:DesignInstance Type=vm:HomeViewModel}"
    d:DesignHeight="900"
    d:DesignWidth="1330"
    DataContextChanged="HomeView_DataContextChanged"
    IsVisibleChanged="HomeView_IsVisibleChanged"
    Loaded="HomeView_Loaded"
    Unloaded="HomeView_Unloaded"
    mc:Ignorable="d">

    <UserControl.Resources>
        <Style x:Key="HomeNavButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource SecondaryForegroundSolidColorBrush}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundSolidColorBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="HomeIconButton" TargetType="Button">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="4,0,0,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource SeparateSolidColorBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundSolidColorBrush}" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="PART_Border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="5">
                            <Viewbox
                                Width="11"
                                Height="11"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                                <Path
                                    extensions:PathExtensions.StringKeyData="{TemplateBinding Content}"
                                    Fill="{TemplateBinding Foreground}"
                                    Stretch="Uniform" />
                            </Viewbox>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="PART_Border" Property="Background" Value="{DynamicResource SecondarySolidColorBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HomeTagBorder" TargetType="Border">
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Background" Value="{DynamicResource SecondarySolidColorBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SeparateSolidColorBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <!--
            Source logos need a little more room than the sort glyphs.
            CurseForge/Modrinth/Nightworld keep their native vector silhouettes from Icons.xaml.
        -->
        <Style x:Key="HomeSourceIconListItem" TargetType="{x:Type ListViewItem}">
            <Setter Property="DataContext" Value="{Binding}" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListViewItem}">
                        <Border
                            x:Name="PART_Border"
                            Width="40"
                            Height="36"
                            Padding="5"
                            Background="Transparent"
                            CornerRadius="6">
                            <Viewbox
                                Width="22"
                                Height="20"
                                Stretch="Uniform">
                                <Path
                                    x:Name="PART_Path"
                                    extensions:PathExtensions.StringKeyData="{TemplateBinding Content}"
                                    Fill="{DynamicResource PrimaryForegroundSolidColorBrush}"
                                    Stretch="Uniform" />
                            </Viewbox>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="PART_Border" Property="Background" Value="{DynamicResource SecondarySolidColorBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="PART_Border" Property="Background" Value="{DynamicResource ActivitySolidColorBrush}" />
                                <Setter TargetName="PART_Path" Property="Fill" Value="{DynamicResource DefaultButtonForegroundColorBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HomeSortIconListItem" TargetType="{x:Type ListViewItem}">
            <Setter Property="DataContext" Value="{Binding}" />
            <Setter Property="Margin" Value="0,0,5,0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListViewItem}">
                        <Border
                            x:Name="PART_Border"
                            Width="36"
                            Height="34"
                            Padding="5"
                            Background="Transparent"
                            CornerRadius="6">
                            <Viewbox
                                Width="20"
                                Height="20"
                                Stretch="Uniform">
                                <Path
                                    x:Name="PART_Path"
                                    extensions:PathExtensions.StringKeyData="{TemplateBinding Content}"
                                    Fill="{DynamicResource PrimaryForegroundSolidColorBrush}"
                                    Stretch="Uniform" />
                            </Viewbox>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="PART_Border" Property="Background" Value="{DynamicResource SecondarySolidColorBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="PART_Border" Property="Background" Value="{DynamicResource ActivitySolidColorBrush}" />
                                <Setter TargetName="PART_Path" Property="Fill" Value="{DynamicResource DefaultButtonForegroundColorBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  IMPORTANT: this is the CatalogView instance form, not a redesigned home-page form.  -->
        <DataTemplate x:Key="CatalogInstanceTemplate" DataType="{x:Type instanceModel:InstanceModelBase}">
            <oldinstanceform:OldInstanceForm
                Margin="0,0,0,16"
                InCatalog="True"
                LogoButtonCommand="{Binding DataContext.Catalog.OpenInstanceProfileMenu, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                LogoButtonCommandParameter="{Binding}"
                OpenAddonsPageCommand="{Binding DataContext.Catalog.OpenAddonsPageCommand, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
                StretchToAvailableWidth="True" />
        </DataTemplate>

        <DataTemplate x:Key="RecommendationCardTemplate" DataType="{x:Type instanceModel:InstanceModelBase}">
            <Border
                Margin="0,0,8,0"
                Padding="12"
                Background="{DynamicResource PrimarySolidColorBrush}"
                BorderBrush="{DynamicResource InstanceFormBorderSolidColorBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="74" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="74" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border
                            Width="70"
                            Height="70"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Background="{Binding Logo, Converter={converters:ImageSourceNullValidateConverter}, ConverterParameter={x:Static media:Stretch.UniformToFill}}"
                            CornerRadius="6" />

                        <StackPanel Grid.Column="1" Margin="8,1,0,0">
                            <TextBlock
                                FontSize="13"
                                Foreground="{DynamicResource PrimaryForegroundSolidColorBrush}"
                                Text="{Binding Name}"
                                TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                Margin="0,4,0,0"
                                FontSize="11"
                                Foreground="{DynamicResource SecondaryForegroundSolidColorBrush}"
                                Text="{Binding Author, StringFormat=by {0}}"
                                TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Grid>

                    <TextBlock
                        Grid.Row="1"
                        MaxHeight="34"
                        Margin="0,8,0,7"
                        FontSize="12"
                        Foreground="{DynamicResource PrimaryForegroundSolidColorBrush}"
                        Text="{Binding Summary}"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="Wrap" />

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                            <Border Style="{StaticResource HomeTagBorder}">
                                <TextBlock
                                    FontSize="12"
                                    FontWeight="Medium"
                                    Foreground="{DynamicResource PrimaryForegroundSolidColorBrush}"
                                    Text="{Binding GameVersion.Id}" />
                            </Border>
                            <Border Style="{StaticResource HomeTagBorder}">
                                <TextBlock
                                    FontSize="12"
                                    FontWeight="Medium"
                                    Foreground="{DynamicResource PrimaryForegroundSolidColorBrush}"
                                    Text="{Binding Source}" />
                            </Border>
                        </StackPanel>
                        <Button
                            Grid.Column="1"
                            Height="34"
                            MinWidth="108"
                            Padding="13,0"
                            Background="{DynamicResource SecondarySolidColorBrush}"
                            BorderBrush="{DynamicResource SeparateSolidColorBrush}"
                            BorderThickness="1"
                            Command="{Binding DataContext.UpdateInstanceCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                            CommandParameter="{Binding}"
                            Cursor="Hand"
                            Visibility="{Binding InstanceClient.UpdateAvailable, Converter={converters:BooleanToVisibilityConverter}}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border
                                        x:Name="PART_UpdateBorder"
                                        Padding="{TemplateBinding Padding}"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="7">
                                        <StackPanel
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Orientation="Horizontal">
                                            <Viewbox
                                                Width="14"
                                                Height="14"
                                                Margin="0,0,8,0">
                                                <Path
                                                    x:Name="PART_UpdateGlyph"
                                                    extensions:PathExtensions.StringKeyData="Update"
                                                    Fill="{DynamicResource SecondaryForegroundSolidColorBrush}"
                                                    Stretch="Uniform" />
                                            </Viewbox>
                                            <TextBlock
                                                x:Name="PART_UpdateText"
                                                FontSize="12.5"
                                                FontWeight="SemiBold"
                                                Foreground="{DynamicResource PrimaryForegroundSolidColorBrush}"
                                                Text="{DynamicResource Update}" />
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="PART_UpdateBorder" Property="Background" Value="{DynamicResource PrimarySolidColorBrush}" />
                                            <Setter TargetName="PART_UpdateBorder" Property="BorderBrush" Value="{DynamicResource ActivitySolidColorBrush}" />
                                            <Setter TargetName="PART_UpdateGlyph" Property="Fill" Value="{DynamicResource PrimaryForegroundSolidColorBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="PART_UpdateBorder" Property="Background" Value="{DynamicResource ActivitySolidColorBrush}" />
                                            <Setter TargetName="PART_UpdateText" Property="Foreground" Value="{DynamicResource DefaultButtonForegroundColorBrush}" />
                                            <Setter TargetName="PART_UpdateGlyph" Property="Fill" Value="{DynamicResource DefaultButtonForegroundColorBrush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                </Grid>
            </Border>
        </DataTemplate>

        <Style x:Key="SideFeatureButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1" ScaleY="1" />
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation
                                                Storyboard.TargetProperty="RenderTransform.ScaleX"
                                                To="1.025"
                                                Duration="0:0:0.16" />
                                            <DoubleAnimation
                                                Storyboard.TargetProperty="RenderTransform.ScaleY"
                                                To="1.025"
                                                Duration="0:0:0.16" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation
                                                Storyboard.TargetProperty="RenderTransform.ScaleX"
                                                To="1"
                                                Duration="0:0:0.16" />
                                            <DoubleAnimation
                                                Storyboard.TargetProperty="RenderTransform.ScaleY"
                                                To="1"
                                                Duration="0:0:0.16" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid
        x:Name="HomeRoot"
        Background="{DynamicResource PageSolidColorBrush}"
        RenderOptions.BitmapScalingMode="HighQuality">
        <!--
            One page ScrollViewer on purpose: hero, recommendations, catalog forms and filters
            move as one surface. Expensive live-resize effects are deliberately avoided.
        -->
        <ScrollViewer
            x:Name="PageScrollViewer"
            HorizontalScrollBarVisibility="Disabled"
            ScrollChanged="PageScrollViewer_ScrollChanged"
            VerticalScrollBarVisibility="Auto">
            <Grid Margin="44,26,44,40">
                <Grid.RowDefinitions>
                    <RowDefinition Height="34" />
                    <RowDefinition Height="370" />
                    <RowDefinition Height="190" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!--  Local home navigation only. Existing LeftPanel is outside this view and remains untouched.  -->
                <StackPanel VerticalAlignment="Top" Orientation="Horizontal">
                    <StackPanel Margin="0,0,30,0">
                        <Button
                            Height="24"
                            Content="Главная"
                            Foreground="#238BFF"
                            Style="{StaticResource HomeNavButton}" />
                        <Border
                            Height="2"
                            Margin="0,2,0,0"
                            Background="#238BFF" />
                    </StackPanel>
                    <Button
                        Height="24"
                        Margin="0,0,30,0"
                        Content="Новости"
                        Style="{StaticResource HomeNavButton}" />
                    <Button
                        Height="24"
                        Content="Еще че-то"
                        Style="{StaticResource HomeNavButton}" />
                </StackPanel>

                <!--  Microsoft Store style rotating feature strip. DataContexts are assigned from Catalog.Model.Instances in code-behind.  -->
                <Grid
                    x:Name="FeatureStrip"
                    Grid.Row="1"
                    Margin="0,8,0,16"
                    MouseEnter="FeatureStrip_MouseEnter"
                    MouseLeave="FeatureStrip_MouseLeave">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2.2*" />
                        <ColumnDefinition Width="0.67*" />
                        <ColumnDefinition Width="0.67*" />
                        <ColumnDefinition Width="0.67*" />
                    </Grid.ColumnDefinitions>

                    <Border
                        x:Name="HeroCardSurface"
                        Grid.Column="0"
                        Margin="0,0,10,0"
                        Background="{DynamicResource PrimarySolidColorBrush}"
                        ClipToBounds="True"
                        CornerRadius="10"
                        Cursor="Hand"
                        MouseLeftButtonUp="HeroCard_MouseLeftButtonUp"
                        SizeChanged="RoundedClip_SizeChanged">
                        <Grid x:Name="HeroContentHost" Opacity="1">
                            <Grid.RenderTransform>
                                <TranslateTransform x:Name="HeroTranslate" X="0" />
                            </Grid.RenderTransform>

                            <Grid ClipToBounds="True">
                                <Border
                                    Margin="-48"
                                    Background="{Binding Logo, Converter={converters:ImageSourceNullValidateConverter}, ConverterParameter={x:Static media:Stretch.UniformToFill}}"
                                    Opacity="0.46"
                                    RenderOptions.BitmapScalingMode="LowQuality">
                                    <Border.RenderTransform>
                                        <ScaleTransform ScaleX="1.10" ScaleY="1.10" />
                                    </Border.RenderTransform>
                                </Border>
                                <Rectangle Fill="#30000000" />
                            </Grid>
                            <Rectangle>
                                <Rectangle.Fill>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Offset="0" Color="#08000000" />
                                        <GradientStop Offset="0.52" Color="#22000000" />
                                        <GradientStop Offset="1" Color="#B8000000" />
                                    </LinearGradientBrush>
                                </Rectangle.Fill>
                            </Rectangle>

                            <!--
                                Foreground artwork and copy share one 236px-high row.
                                This keeps the copy baseline inside the artwork's bottom edge.
                            -->
                            <Grid
                                Height="220"
                                Margin="34,0,30,0"
                                VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="220" />
                                    <ColumnDefinition Width="30" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Border
                                    Grid.Column="0"
                                    Width="220"
                                    Height="220"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Background="{Binding Logo, Converter={converters:ImageSourceNullValidateConverter}, ConverterParameter={x:Static media:Stretch.Uniform}}"
                                    CornerRadius="12"
                                    RenderOptions.BitmapScalingMode="HighQuality" />

                                <StackPanel
                                    Grid.Column="2"
                                    MaxWidth="560"
                                    VerticalAlignment="Center">
                                    <TextBlock
                                        FontSize="20"
                                        FontWeight="Bold"
                                        Foreground="White"
                                        Text="{Binding Name}"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        MaxHeight="46"
                                        Margin="0,8,0,0"
                                        HorizontalAlignment="Left"
                                        FontSize="12"
                                        Foreground="#E2E5EA"
                                        Text="{Binding Summary}"
                                        TextTrimming="CharacterEllipsis"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>

                    <Button
                        x:Name="SideFeature0"
                        Grid.Column="1"
                        Margin="0,0,10,0"
                        Click="SideFeature_Click"
                        Style="{StaticResource SideFeatureButton}">
                        <Border
                            x:Name="SideFeatureSurface0"
                            Background="{DynamicResource PrimarySolidColorBrush}"
                            ClipToBounds="True"
                            CornerRadius="10"
                            SizeChanged="RoundedClip_SizeChanged">
                            <Grid>
                                <Grid ClipToBounds="True">
                                    <Border
                                        Margin="-28"
                                        Background="{Binding Logo, Converter={converters:ImageSourceNullValidateConverter}, ConverterParameter={x:Static media:Stretch.UniformToFill}}"
                                        Opacity="0.54"
                                        RenderOptions.BitmapScalingMode="LowQuality">
                                        <Border.RenderTransform>
                                            <ScaleTransform ScaleX="1.10" ScaleY="1.10" />
                                        </Border.RenderTransform>
                                    </Border>
                                    <Border
                                        Width="128"
                                        Height="128"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Background="{Binding Logo, Converter={converters:ImageSourceNullValidateConverter}, ConverterParameter={x:Static media:Stretch.Uniform}}"
                                        CornerRadius="9"
                                        RenderOptions.BitmapScalingMode="HighQuality" />
                                </Grid>
                                <Rectangle>
                                    <Rectangle.Fill>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Offset="0.3" Color="#00000000" />
                                            <GradientStop Offset="1" Color="#C9000000" />
                                        </LinearGradientBrush>
                                    </Rectangle.Fill>
                                </Rectangle>
                                <TextBlock
                                    Margin="12,0,10,22"
                                    VerticalAlignment="Bottom"
                                    FontSize="17"
                                    FontWeight="Bold"
                                    Foreground="White"
                                    Text="{Binding Name}"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="Wrap" />
                            </Grid>
                        </Border>
                    </Button>

                    <Button
                        x:Name="SideFeature1"
                        Grid.Column="2"
                        Margin="0,0,10,0"
                        Click="SideFeature_Click"
                        Style="{StaticResource SideFeatureButton}">
                        <Border
                            x:Name="SideFeatureSurface1"
                            Background="{DynamicResource PrimarySolidColorBrush}"
                            ClipToBounds="True"
                            CornerRadius="10"
                            SizeChanged="RoundedClip_SizeChanged">
                            <Grid>
                                <Grid ClipToBounds="True">
                                    <Border
                                        Margin="-28"
                                        Background="{Binding Logo, Converter={converters:ImageSourceNullValidateConverter}, ConverterParameter={x:Static media:Stretch.UniformToFill}}"
                                        Opacity="0.54"
                                        RenderOptions.BitmapScalingMode="LowQuality">
                                        <Border.RenderTransform>
                                            <ScaleTransform ScaleX="1.10" ScaleY="1.10" />
                                        </Border.RenderTransform>
                                    </Border>
                                    <Border
                                        Width="128"
                                        Height="128"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Background="{Binding Logo, Converter={converters:ImageSourceNullValidateConverter}, ConverterParameter={x:Static media:Stretch.Uniform}}"
                                        CornerRadius="9"
                                        RenderOptions.BitmapScalingMode="HighQuality" />
                                </Grid>
                                <Rectangle>
                                    <Rectangle.Fill>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Offset="0.3" Color="#00000000" />
                                            <GradientStop Offset="1" Color="#C9000000" />
                                        </LinearGradientBrush>
                                    </Rectangle.Fill>
                                </Rectangle>
                                <TextBlock
                                    Margin="12,0,10,22"
                                    VerticalAlignment="Bottom"
                                    FontSize="17"
                                    FontWeight="Bold"
                                    Foreground="White"
                                    Text="{Binding Name}"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="Wrap" />
                            </Grid>
                        </Border>
                    </Button>

                    <Button
                        x:Name="SideFeature2"
                        Grid.Column="3"
                        Click="SideFeature_Click"
                        Style="{StaticResource SideFeatureButton}">
                        <Border
                            x:Name="SideFeatureSurface2"
                            Background="{DynamicResource PrimarySolidColorBrush}"
                            ClipToBounds="True"
                            CornerRadius="10"
                            SizeChanged="RoundedClip_SizeChanged">
                            <Grid>
                                <Grid ClipToBounds="True">
                                    <Border
                                        Margin="-28"
                                        Background="{Binding Logo, Converter={converters:ImageSourceNullValidateConverter}, ConverterParameter={x:Static media:Stretch.UniformToFill}}"
                                        Opacity="0.54"
                                        RenderOptions.BitmapScalingMode="LowQuality">
                                        <Border.RenderTransform>
                                            <ScaleTransform ScaleX="1.10" ScaleY="1.10" />
                                        </Border.RenderTransform>
                                    </Border>
                                    <Border
                                        Width="128"
                                        Height="128"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Background="{Binding Logo, Converter={converters:ImageSourceNullValidateConverter}, ConverterParameter={x:Static media:Stretch.Uniform}}"
                                        CornerRadius="9"
                                        RenderOptions.BitmapScalingMode="HighQuality" />
                                </Grid>
                                <Rectangle>
                                    <Rectangle.Fill>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Offset="0.3" Color="#00000000" />
                                            <GradientStop Offset="1" Color="#C9000000" />
                                        </LinearGradientBrush>
                                    </Rectangle.Fill>
                                </Rectangle>
                                <TextBlock
                                    Margin="12,0,10,22"
                                    VerticalAlignment="Bottom"
                                    FontSize="17"
                                    FontWeight="Bold"
                                    Foreground="White"
                                    Text="{Binding Name}"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="Wrap" />
                            </Grid>
                        </Border>
                    </Button>
                </Grid>

                <!--
                    Exactly four cards from the same live Catalog source. UniformGrid lets
                    WPF distribute width without an ActualWidth binding/layout feedback loop.
                -->
                <ItemsControl
                    x:Name="RecommendationCards"
                    Grid.Row="2"
                    Height="190"
                    ClipToBounds="True"
                    ItemTemplate="{StaticResource RecommendationCardTemplate}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="4" Rows="1" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="HorizontalAlignment" Value="Stretch" />
                            <Setter Property="VerticalAlignment" Value="Stretch" />
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                </ItemsControl>

                <!--  Catalog block. It intentionally reuses OldInstanceForm and the Catalog filter model.  -->
                <Grid
                    x:Name="CatalogBlock"
                    Grid.Row="3"
                    Margin="0,38,0,0"
                    SizeChanged="CatalogBlock_SizeChanged">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="326" />
                    </Grid.ColumnDefinitions>

                    <!--
                        The filter has natural height. While scrolling, code-behind translates only this card
                        after its header reaches the viewport top, creating a sticky sidebar without a full-height slab.
                    -->
                    <Border
                        x:Name="FilterStickyAnchor"
                        Grid.Column="1"
                        Width="1"
                        Height="1"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Opacity="0" />

                    <Border
                        x:Name="FilterPanel"
                        Grid.Column="1"
                        Margin="20,0,0,0"
                        Padding="14"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Top"
                        Panel.ZIndex="20"
                        Background="{DynamicResource InstancesFilterSolidColorBrush}"
                        BorderBrush="{DynamicResource InstancesFilterBorderSolidColorBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Visibility="{Binding IsFilterPanelVisible, Converter={converters:BooleanToVisibilityConverter}}">
                        <Border.RenderTransform>
                            <TranslateTransform x:Name="FilterStickyTranslate" Y="0" />
                        </Border.RenderTransform>
                        <StackPanel>
                            <controls:SearchBox
                                Height="38"
                                MinWidth="0"
                                HorizontalAlignment="Stretch"
                                Placeholder="{DynamicResource Search}"
                                SearchCommand="{Binding Catalog.SearchCommand}"
                                Text="{Binding Catalog.Model.SearchFilter, UpdateSourceTrigger=PropertyChanged}" />

                            <Grid Margin="0,16,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel
                                    Margin="0,0,0,0"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal">
                                    <Viewbox
                                        Width="15"
                                        Height="15"
                                        Margin="0,0,8,0">
                                        <Path
                                            extensions:PathExtensions.StringKeyData="Filter"
                                            Fill="{DynamicResource PrimaryForegroundSolidColorBrush}"
                                            Stretch="Uniform" />
                                    </Viewbox>
                                    <TextBlock
                                        FontSize="13"
                                        Foreground="{DynamicResource PrimaryForegroundSolidColorBrush}"
                                        Text="Filters" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button
                                        Command="{Binding RefreshCatalogCommand}"
                                        Content="Update"
                                        Style="{StaticResource HomeIconButton}"
                                        ToolTip="Refresh" />
                                    <Button
                                        Command="{Binding ToggleFilterPanelCommand}"
                                        Content="Close"
                                        Style="{StaticResource HomeIconButton}"
                                        ToolTip="Close filters" />
                                </StackPanel>
                            </Grid>

                            <Border
                                Margin="0,12,0,0"
                                BorderBrush="{DynamicResource SeparateSolidColorBrush}"
                                BorderThickness="0,1,0,0" />

                            <!--  SOURCE  -->
                            <Grid Margin="0,13,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    FontSize="11.5"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource SecondaryForegroundSolidColorBrush}"
                                    Text="SOURCE" />
                                <TextBlock
                                    Grid.Column="1"
                                    extensions:TextBlockExtensions.TextByKey="{Binding Catalog.Model.FilterPanel.SelectedSource.TranslateKey}"
                                    FontSize="12.5"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource PrimaryForegroundSolidColorBrush}" />
                            </Grid>
                            <Border
                                Margin="0,7,0,0"
                                Padding="3"
                                Background="{DynamicResource SecondarySolidColorBrush}"
                                BorderBrush="{DynamicResource SeparateSolidColorBrush}"
                                BorderThickness="1"
                                CornerRadius="5">
                                <ListView
                                    Background="Transparent"
                                    BorderThickness="0"
                                    ItemsSource="{Binding Catalog.Model.FilterPanel.Sources}"
                                    SelectedItem="{Binding Catalog.Model.FilterPanel.SelectedSource}">
                                    <ListView.ItemContainerStyle>
                                        <Style BasedOn="{StaticResource HomeSourceIconListItem}" TargetType="{x:Type ListViewItem}">
                                            <Setter Property="Content" Value="{Binding Value, Converter={converters:ToStringConverter}}" />
                                        </Style>
                                    </ListView.ItemContainerStyle>
                                    <ListView.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel IsItemsHost="True" />
                                        </ItemsPanelTemplate>
                                    </ListView.ItemsPanel>
                                </ListView>
                            </Border>

                            <!--  SORTING  -->
                            <StackPanel Margin="0,16,0,0" Visibility="{Binding Catalog.Model.FilterPanel.SortByParams.Count, Converter={converters:CountToVisibilityConverter}}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        FontSize="11.5"
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource SecondaryForegroundSolidColorBrush}"
                                        Text="SORTING" />
                                    <TextBlock
                                        Grid.Column="1"
                                        extensions:TextBlockExtensions.TextByKey="{Binding Catalog.Model.FilterPanel.SelectedSortByParam.TranslateKey}"
                                        FontSize="12.5"
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource PrimaryForegroundSolidColorBrush}" />
                                </Grid>
                                <Border
                                    Margin="0,7,0,0"
                                    Padding="3"
                                    Background="{DynamicResource SecondarySolidColorBrush}"
                                    BorderBrush="{DynamicResource SeparateSolidColorBrush}"
                                    BorderThickness="1"
                                    CornerRadius="5">
                                    <ListView
                                        Background="Transparent"
                                        BorderThickness="0"
                                        ItemsSource="{Binding Catalog.Model.FilterPanel.SortByParams}"
                                        SelectedItem="{Binding Catalog.Model.FilterPanel.SelectedSortByParam}">
                                        <ListView.ItemContainerStyle>
                                            <Style BasedOn="{StaticResource HomeSortIconListItem}" TargetType="{x:Type ListViewItem}">
                                                <Setter Property="Content" Value="{Binding TranslateKey}" />
                                            </Style>
                                        </ListView.ItemContainerStyle>
                                        <ListView.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel IsItemsHost="True" />
                                            </ItemsPanelTemplate>
                                        </ListView.ItemsPanel>
                                    </ListView>
                                </Border>
                            </StackPanel>

                            <!--  VERSION  -->
                            <StackPanel Margin="0,16,0,0">
                                <TextBlock
                                    FontSize="11.5"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource SecondaryForegroundSolidColorBrush}"
                                    Text="VERSION" />
                                <ComboBox
                                    Margin="0,7,0,0"
                                    ItemsSource="{Binding Catalog.Model.FilterPanel.VersionCollectionViewSource.View}"
                                    SelectedValue="{Binding Catalog.Model.FilterPanel.SelectedVersion, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>

                            <!--  CATEGORIES  -->
                            <StackPanel Margin="0,16,0,0">
                                <TextBlock
                                    FontSize="11.5"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource SecondaryForegroundSolidColorBrush}"
                                    Text="CATEGORIES" />
                                <core:If Margin="0,4,0,0" Condition="{Binding Catalog.Model.FilterPanel.IsCategoryLoading}">
                                    <core:If.False>
                                        <Grid Height="96">
                                            <controls:CircleLoader
                                                Width="24"
                                                Height="24"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                IsActive="{Binding Catalog.Model.FilterPanel.IsCategoryLoading}" />
                                        </Grid>
                                    </core:If.False>
                                    <core:If.True>
                                        <ItemsControl ItemsSource="{Binding Catalog.Model.FilterPanel.AvailableCategories}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel IsItemsHost="True" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type objects:CategoryBase}">
                                                    <ToggleButton
                                                        Margin="0,4,4,0"
                                                        Command="{Binding DataContext.Catalog.SelectCategoryCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                        CommandParameter="{Binding}"
                                                        Content="{Binding Name}"
                                                        Style="{StaticResource CategoryToggleButton}" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </core:If.True>
                                </core:If>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Grid Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Button
                            Width="92"
                            Height="32"
                            Margin="0,0,0,12"
                            HorizontalAlignment="Right"
                            Command="{Binding ToggleFilterPanelCommand}"
                            Content="Filters"
                            Visibility="{Binding IsFilterPanelVisible, Converter={converters:NegativeBooleanToVisibilityConverter}}" />

                        <core:If Grid.Row="1" Condition="{Binding Catalog.Model.Instances, Converter={converters:IsCollectionEmptyConverter}}">
                            <core:If.True>
                                <controls:Empty
                                    Height="220"
                                    VerticalAlignment="Stretch"
                                    Description="Каталог оказался пуст" />
                            </core:If.True>
                            <core:If.False>
                                <StackPanel>
                                    <ItemsControl
                                        x:Name="CatalogInstanceList"
                                        HorizontalAlignment="Stretch"
                                        ItemTemplate="{StaticResource CatalogInstanceTemplate}"
                                        ItemsSource="{Binding Catalog.Model.Instances}"
                                        ScrollViewer.CanContentScroll="True">
                                        <ItemsControl.ItemContainerStyle>
                                            <Style TargetType="ContentPresenter">
                                                <Setter Property="HorizontalAlignment" Value="Stretch" />
                                            </Style>
                                        </ItemsControl.ItemContainerStyle>
                                    </ItemsControl>

                                    <controls:Paginator
                                        Margin="0,0,0,24"
                                        CurrentPageIndex="{Binding Catalog.Model.CurrentPageIndex, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                        NextCommand="{Binding Catalog.NextPageCommand}"
                                        PageCount="{Binding Catalog.Model.PageCount, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                        PrevCommand="{Binding Catalog.PrevPageCommand}"
                                        ToCommand="{Binding Catalog.ToCurrentPageIndexCommand}" />
                                </StackPanel>
                            </core:If.False>
                        </core:If>
                    </Grid>
                </Grid>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
