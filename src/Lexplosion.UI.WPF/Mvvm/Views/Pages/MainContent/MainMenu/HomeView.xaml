<UserControl
    x:Class="Lexplosion.UI.WPF.Mvvm.Views.Pages.MainContent.MainMenu.HomeView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Lexplosion.UI.WPF.Controls"
    xmlns:converters="clr-namespace:Lexplosion.UI.WPF.Core.Converters"
    xmlns:core="clr-namespace:Lexplosion.UI.WPF.Core"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:extensions="clr-namespace:Lexplosion.UI.WPF.Extensions"
    xmlns:instanceModel="clr-namespace:Lexplosion.UI.WPF.Mvvm.Models.Mvvm.InstanceModel"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:media="clr-namespace:System.Windows.Media;assembly=PresentationCore"
    xmlns:objects="clr-namespace:Lexplosion.Logic.Objects;assembly=Lexplosion.Core"
    xmlns:oldinstanceform="clr-namespace:Lexplosion.UI.WPF.Controls.OldInstanceForm"
    xmlns:virtualization="clr-namespace:WpfToolkit.Controls;assembly=VirtualizingWrapPanel"
    xmlns:vm="clr-namespace:Lexplosion.UI.WPF.Mvvm.ViewModels.MainContent.MainMenu"
    d:DataContext="{d:DesignInstance Type=vm:HomeViewModel}"
    d:DesignHeight="900"
    d:DesignWidth="1330"
    DataContextChanged="HomeView_DataContextChanged"
    IsVisibleChanged="HomeView_IsVisibleChanged"
    Loaded="HomeView_Loaded"
    Unloaded="HomeView_Unloaded"
    mc:Ignorable="d">

    <UserControl.Resources>
        

        

        <Style x:Key="HomeTagBorder" TargetType="Border">
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Background" Value="{DynamicResource SecondarySolidColorBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SeparateSolidColorBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <!--
            Source logos need a little more room than the sort glyphs.
            CurseForge/Modrinth/Nightworld keep their native vector silhouettes from Icons.xaml.
        -->
        <Style x:Key="HomeSourceIconListItem" TargetType="{x:Type ListViewItem}">
            <Setter Property="DataContext" Value="{Binding}" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListViewItem}">
                        <Border
                            x:Name="PART_Border"
                            Width="40"
                            Height="36"
                            Padding="5"
                            Background="Transparent"
                            CornerRadius="6">
                            <Viewbox
                                Width="22"
                                Height="20"
                                Stretch="Uniform">
                                <Path
                                    x:Name="PART_Path"
                                    extensions:PathExtensions.StringKeyData="{TemplateBinding Content}"
                                    Fill="{DynamicResource PrimaryForegroundSolidColorBrush}"
                                    Stretch="Uniform" />
                            </Viewbox>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="PART_Border" Property="Background" Value="{DynamicResource SecondarySolidColorBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="PART_Border" Property="Background" Value="{DynamicResource ActivitySolidColorBrush}" />
                                <Setter TargetName="PART_Path" Property="Fill" Value="{DynamicResource DefaultButtonForegroundColorBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HomeSortIconListItem" TargetType="{x:Type ListViewItem}">
            <Setter Property="DataContext" Value="{Binding}" />
            <Setter Property="Margin" Value="0,0,5,0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListViewItem}">
                        <Border
                            x:Name="PART_Border"
                            Width="36"
                            Height="34"
                            Padding="5"
                            Background="Transparent"
                            CornerRadius="6">
                            <Viewbox
                                Width="17"
                                Height="17"
                                Stretch="Uniform">
                                <Path
                                    x:Name="PART_Path"
                                    extensions:PathExtensions.StringKeyData="{TemplateBinding Content}"
                                    Fill="{DynamicResource PrimaryForegroundSolidColorBrush}"
                                    Stretch="Uniform" />
                            </Viewbox>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="PART_Border" Property="Background" Value="{DynamicResource SecondarySolidColorBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="PART_Border" Property="Background" Value="{DynamicResource ActivitySolidColorBrush}" />
                                <Setter TargetName="PART_Path" Property="Fill" Value="{DynamicResource DefaultButtonForegroundColorBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  IMPORTANT: this is the CatalogView instance form, not a redesigned home-page form.  -->
        <DataTemplate x:Key="CatalogInstanceTemplate" DataType="{x:Type instanceModel:InstanceModelBase}">
            <oldinstanceform:OldInstanceForm
                Margin="0,0,0,16"
                InCatalog="True"
                LogoButtonCommand="{Binding DataContext.Catalog.OpenInstanceProfileMenu, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                LogoButtonCommandParameter="{Binding}"
                OpenAddonsPageCommand="{Binding DataContext.Catalog.OpenAddonsPageCommand, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
                StretchToAvailableWidth="True" />
        </DataTemplate>

        <DataTemplate x:Key="RecommendationCardTemplate" DataType="{x:Type instanceModel:InstanceModelBase}">
            <Border
                Padding="12"
                Background="{DynamicResource PrimarySolidColorBrush}"
                BorderBrush="{DynamicResource InstanceFormBorderSolidColorBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Cursor="Hand"
                MouseLeftButtonUp="RecommendationCard_MouseLeftButtonUp">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="74" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="74" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border
                            Width="70"
                            Height="70"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Background="{Binding Logo, Converter={converters:ImageSourceNullValidateConverter}, ConverterParameter={x:Static media:Stretch.UniformToFill}}"
                            CornerRadius="6" />

                        <StackPanel Grid.Column="1" Margin="8,1,0,0">
                            <TextBlock
                                FontSize="13"
                                Foreground="{DynamicResource PrimaryForegroundSolidColorBrush}"
                                Text="{Binding Name}"
                                TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                Margin="0,0,0,0"
                                FontSize="11"
                                Foreground="{DynamicResource SecondaryForegroundSolidColorBrush}"
                                TextTrimming="CharacterEllipsis">
                                <Run Text="{DynamicResource ByAuthor}" />
                                <Run Text=" " />
                                <Run Text="{Binding Author, Mode=OneWay}" />
                            </TextBlock>
                        </StackPanel>
                    </Grid>

                    <TextBlock
                        Grid.Row="1"
                        MaxHeight="34"
                        Margin="0,8,0,7"
                        FontSize="12"
                        Foreground="{DynamicResource PrimaryForegroundSolidColorBrush}"
                        Text="{Binding Summary}"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="Wrap" />

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                            <Border Style="{StaticResource HomeTagBorder}">
                                <TextBlock
                                    FontSize="12"
                                    FontWeight="Medium"
                                    Foreground="{DynamicResource PrimaryForegroundSolidColorBrush}"
                                    Text="{Binding GameVersion.Id}" />
                            </Border>
                            <Border Style="{StaticResource HomeTagBorder}">
                                <TextBlock
                                    FontSize="12"
                                    FontWeight="Medium"
                                    Foreground="{DynamicResource PrimaryForegroundSolidColorBrush}"
                                    Text="{Binding Source}" />
                            </Border>
                        </StackPanel>
                        <controls:AdvancedButton
                            Grid.Column="1"
                            Height="34"
                            MinWidth="108"
                            Padding="13,0"
                            Background="{DynamicResource SecondarySolidColorBrush}"
                            BorderBrush="{DynamicResource SeparateSolidColorBrush}"
                            BorderThickness="1"
                            CornerRadius="7"
                            FontSize="12.5"
                            Command="{Binding DataContext.UpdateInstanceCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                            CommandParameter="{Binding}"
                            Style="{StaticResource sm-default}"
                            Visibility="{Binding InstanceClient.UpdateAvailable, Converter={converters:BooleanToVisibilityConverter}}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Viewbox Width="14" Height="14" Margin="0,0,6,0">
                                    <Path
                                        extensions:PathExtensions.StringKeyData="Update"
                                        Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type controls:AdvancedButton}}}"
                                        Stretch="Uniform" />
                                </Viewbox>
                                <TextBlock
                                    VerticalAlignment="Center"
                                    Text="{DynamicResource Update}" />
                            </StackPanel>
                        </controls:AdvancedButton>
                    </Grid>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- Featured data is independent from the paginated catalog.
             Loading another page must not dim, clear or rebuild the hero. -->
        <Style x:Key="HomeFeaturedVisibilityStyle" TargetType="{x:Type FrameworkElement}">
            <Style.Triggers>
                <DataTrigger
                    Binding="{Binding FeaturedInstances, Converter={converters:IsCollectionEmptyConverter}}"
                    Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding ElementName=HomeTabs, Path=SelectedIndex}" Value="1">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding ElementName=HomeTabs, Path=SelectedIndex}" Value="2">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SideFeatureButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1" ScaleY="1" />
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation
                                                Storyboard.TargetProperty="RenderTransform.ScaleX"
                                                To="1.025"
                                                Duration="0:0:0.16" />
                                            <DoubleAnimation
                                                Storyboard.TargetProperty="RenderTransform.ScaleY"
                                                To="1.025"
                                                Duration="0:0:0.16" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation
                                                Storyboard.TargetProperty="RenderTransform.ScaleX"
                                                To="1"
                                                Duration="0:0:0.16" />
                                            <DoubleAnimation
                                                Storyboard.TargetProperty="RenderTransform.ScaleY"
                                                To="1"
                                                Duration="0:0:0.16" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid
        x:Name="HomeRoot"
        Background="{DynamicResource PageSolidColorBrush}"
        RenderOptions.BitmapScalingMode="HighQuality">
        <!--
            One page ScrollViewer on purpose: hero, recommendations, catalog forms and filters
            move as one surface. Expensive live-resize effects are deliberately avoided.
        -->
        <ScrollViewer
            x:Name="PageScrollViewer"
            Margin="0,0,4,0"
            HorizontalScrollBarVisibility="Disabled"
            ScrollChanged="PageScrollViewer_ScrollChanged"
            VerticalScrollBarVisibility="Auto">
            <ScrollViewer.Resources>
                <!-- Home-only scrollbar. The compact Catalog and the shared theme are unchanged. -->
                <ControlTemplate x:Key="HomeScrollThumbTemplate" TargetType="{x:Type Thumb}">
                    <Grid Width="14" Background="Transparent">
                        <Border
                            x:Name="ThumbBar"
                            Width="6"
                            HorizontalAlignment="Center"
                            Background="{DynamicResource ScrollBarThumbSolidColorBrush}"
                            CornerRadius="3" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ThumbBar" Property="Width" Value="9" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
                <ControlTemplate x:Key="HomeVerticalScrollBarTemplate" TargetType="{x:Type ScrollBar}">
                    <Grid Width="14" Background="Transparent">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb Template="{StaticResource HomeScrollThumbTemplate}" />
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
                <Style TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource {x:Type ScrollBar}}">
                    <Setter Property="Opacity" Value="0.8" />
                    <Style.Triggers>
                        <Trigger Property="Orientation" Value="Vertical">
                            <Setter Property="Template" Value="{StaticResource HomeVerticalScrollBarTemplate}" />
                            <Setter Property="Margin" Value="0,40,0,0" />
                        </Trigger>
                        <DataTrigger
                            Binding="{Binding IsMouseOver, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type ScrollViewer}}}"
                            Value="True">
                            <Setter Property="Opacity" Value="1" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ScrollViewer.Resources>
            <Grid Margin="32,20,32,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="34" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- The same underline tabs used on Friends/Settings; no additional page is created. -->
                <controls:UIUnderlineTabControl
                    x:Name="HomeTabs"
                    Height="34"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    BorderThickness="0"
                    SelectedIndex="0"
                    TabPanelPadding="0">
                    <TabItem Header="Home" Style="{StaticResource UITabItem}" />
                    <TabItem Header="NewsTitle" Style="{StaticResource UITabItem}" />
                    <TabItem Header="More" Style="{StaticResource UITabItem}" />
                </controls:UIUnderlineTabControl>

                <!-- Keep the loading state visible when pagination scrolls back to the top. -->
                <controls:CircleLoader
                    Grid.Row="0"
                    Width="20"
                    Height="20"
                    Margin="0,7,0,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    IsActive="{Binding Catalog.Model.IsLoading}"
                    Visibility="{Binding Catalog.Model.IsLoading, Converter={converters:BooleanToVisibilityConverter}}" />

                <!-- Rotating popular modpacks cached independently of the catalog page. -->
                <Grid
                    x:Name="FeatureStrip"
                    Grid.Row="1"
                    Height="346"
                    Margin="0,8,0,16"
                    MouseEnter="FeatureStrip_MouseEnter"
                    MouseLeave="FeatureStrip_MouseLeave"
                    Style="{StaticResource HomeFeaturedVisibilityStyle}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2.2*" />
                        <ColumnDefinition Width="0.67*" />
                        <ColumnDefinition Width="0.67*" />
                        <ColumnDefinition Width="0.67*" />
                    </Grid.ColumnDefinitions>

                    <Border
                        x:Name="HeroCardSurface"
                        Grid.Column="0"
                        Margin="0,0,10,0"
                        Background="{DynamicResource PrimarySolidColorBrush}"
                        ClipToBounds="True"
                        CornerRadius="10"
                        Cursor="Hand"
                        MouseLeftButtonUp="HeroCard_MouseLeftButtonUp"
                        SizeChanged="RoundedClip_SizeChanged">
                        <Grid x:Name="HeroContentHost" Opacity="1">
                            <Grid.RenderTransform>
                                <TranslateTransform x:Name="HeroTranslate" X="0" />
                            </Grid.RenderTransform>

                            <Grid ClipToBounds="True">
                                <Border
                                    Margin="-48"
                                    Background="{Binding Logo, Converter={converters:ImageSourceNullValidateConverter}, ConverterParameter={x:Static media:Stretch.UniformToFill}}"
                                    Opacity="0.46"
                                    RenderOptions.BitmapScalingMode="LowQuality">
                                    <Border.RenderTransform>
                                        <ScaleTransform ScaleX="1.10" ScaleY="1.10" />
                                    </Border.RenderTransform>
                                </Border>
                                <Rectangle Fill="#30000000" />
                            </Grid>
                            <Rectangle>
                                <Rectangle.Fill>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Offset="0" Color="#08000000" />
                                        <GradientStop Offset="0.52" Color="#22000000" />
                                        <GradientStop Offset="1" Color="#B8000000" />
                                    </LinearGradientBrush>
                                </Rectangle.Fill>
                            </Rectangle>

                            <!--
                                Foreground artwork and copy share one 236px-high row.
                                This keeps the copy baseline inside the artwork's bottom edge.
                            -->
                            <Grid
                                Height="220"
                                Margin="34,0,30,0"
                                VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="220" />
                                    <ColumnDefinition Width="30" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Border
                                    Grid.Column="0"
                                    Width="220"
                                    Height="220"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Background="{Binding Logo, Converter={converters:ImageSourceNullValidateConverter}, ConverterParameter={x:Static media:Stretch.Uniform}}"
                                    CornerRadius="12"
                                    RenderOptions.BitmapScalingMode="HighQuality" />

                                <StackPanel
                                    Grid.Column="2"
                                    MaxWidth="560"
                                    VerticalAlignment="Center">
                                    <TextBlock
                                        FontSize="20"
                                        FontWeight="Bold"
                                        Foreground="White"
                                        Text="{Binding Name}"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        MaxHeight="46"
                                        Margin="0,8,0,0"
                                        HorizontalAlignment="Left"
                                        FontSize="12"
                                        Foreground="#E2E5EA"
                                        Text="{Binding Summary}"
                                        TextTrimming="CharacterEllipsis"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>

                    <Button
                        x:Name="SideFeature0"
                        Grid.Column="1"
                        Margin="0,0,10,0"
                        Click="SideFeature_Click"
                        Style="{StaticResource SideFeatureButton}">
                        <Border
                            x:Name="SideFeatureSurface0"
                            Background="{DynamicResource PrimarySolidColorBrush}"
                            ClipToBounds="True"
                            CornerRadius="10"
                            SizeChanged="RoundedClip_SizeChanged">
                            <Grid>
                                <Grid ClipToBounds="True">
                                    <Border
                                        Margin="-28"
                                        Background="{Binding Logo, Converter={converters:ImageSourceNullValidateConverter}, ConverterParameter={x:Static media:Stretch.UniformToFill}}"
                                        Opacity="0.54"
                                        RenderOptions.BitmapScalingMode="LowQuality">
                                        <Border.RenderTransform>
                                            <ScaleTransform ScaleX="1.10" ScaleY="1.10" />
                                        </Border.RenderTransform>
                                    </Border>
                                    <Border
                                        Width="128"
                                        Height="128"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Background="{Binding Logo, Converter={converters:ImageSourceNullValidateConverter}, ConverterParameter={x:Static media:Stretch.Uniform}}"
                                        CornerRadius="9"
                                        RenderOptions.BitmapScalingMode="HighQuality" />
                                </Grid>
                                <Rectangle>
                                    <Rectangle.Fill>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Offset="0.3" Color="#00000000" />
                                            <GradientStop Offset="1" Color="#C9000000" />
                                        </LinearGradientBrush>
                                    </Rectangle.Fill>
                                </Rectangle>
                                <TextBlock
                                    Margin="12,0,10,22"
                                    VerticalAlignment="Bottom"
                                    FontSize="17"
                                    FontWeight="Bold"
                                    Foreground="White"
                                    Text="{Binding Name}"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="Wrap" />
                            </Grid>
                        </Border>
                    </Button>

                    <Button
                        x:Name="SideFeature1"
                        Grid.Column="2"
                        Margin="0,0,10,0"
                        Click="SideFeature_Click"
                        Style="{StaticResource SideFeatureButton}">
                        <Border
                            x:Name="SideFeatureSurface1"
                            Background="{DynamicResource PrimarySolidColorBrush}"
                            ClipToBounds="True"
                            CornerRadius="10"
                            SizeChanged="RoundedClip_SizeChanged">
                            <Grid>
                                <Grid ClipToBounds="True">
                                    <Border
                                        Margin="-28"
                                        Background="{Binding Logo, Converter={converters:ImageSourceNullValidateConverter}, ConverterParameter={x:Static media:Stretch.UniformToFill}}"
                                        Opacity="0.54"
                                        RenderOptions.BitmapScalingMode="LowQuality">
                                        <Border.RenderTransform>
                                            <ScaleTransform ScaleX="1.10" ScaleY="1.10" />
                                        </Border.RenderTransform>
                                    </Border>
                                    <Border
                                        Width="128"
                                        Height="128"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Background="{Binding Logo, Converter={converters:ImageSourceNullValidateConverter}, ConverterParameter={x:Static media:Stretch.Uniform}}"
                                        CornerRadius="9"
                                        RenderOptions.BitmapScalingMode="HighQuality" />
                                </Grid>
                                <Rectangle>
                                    <Rectangle.Fill>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Offset="0.3" Color="#00000000" />
                                            <GradientStop Offset="1" Color="#C9000000" />
                                        </LinearGradientBrush>
                                    </Rectangle.Fill>
                                </Rectangle>
                                <TextBlock
                                    Margin="12,0,10,22"
                                    VerticalAlignment="Bottom"
                                    FontSize="17"
                                    FontWeight="Bold"
                                    Foreground="White"
                                    Text="{Binding Name}"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="Wrap" />
                            </Grid>
                        </Border>
                    </Button>

                    <Button
                        x:Name="SideFeature2"
                        Grid.Column="3"
                        Click="SideFeature_Click"
                        Style="{StaticResource SideFeatureButton}">
                        <Border
                            x:Name="SideFeatureSurface2"
                            Background="{DynamicResource PrimarySolidColorBrush}"
                            ClipToBounds="True"
                            CornerRadius="10"
                            SizeChanged="RoundedClip_SizeChanged">
                            <Grid>
                                <Grid ClipToBounds="True">
                                    <Border
                                        Margin="-28"
                                        Background="{Binding Logo, Converter={converters:ImageSourceNullValidateConverter}, ConverterParameter={x:Static media:Stretch.UniformToFill}}"
                                        Opacity="0.54"
                                        RenderOptions.BitmapScalingMode="LowQuality">
                                        <Border.RenderTransform>
                                            <ScaleTransform ScaleX="1.10" ScaleY="1.10" />
                                        </Border.RenderTransform>
                                    </Border>
                                    <Border
                                        Width="128"
                                        Height="128"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Background="{Binding Logo, Converter={converters:ImageSourceNullValidateConverter}, ConverterParameter={x:Static media:Stretch.Uniform}}"
                                        CornerRadius="9"
                                        RenderOptions.BitmapScalingMode="HighQuality" />
                                </Grid>
                                <Rectangle>
                                    <Rectangle.Fill>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Offset="0.3" Color="#00000000" />
                                            <GradientStop Offset="1" Color="#C9000000" />
                                        </LinearGradientBrush>
                                    </Rectangle.Fill>
                                </Rectangle>
                                <TextBlock
                                    Margin="12,0,10,22"
                                    VerticalAlignment="Bottom"
                                    FontSize="17"
                                    FontWeight="Bold"
                                    Foreground="White"
                                    Text="{Binding Name}"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="Wrap" />
                            </Grid>
                        </Border>
                    </Button>
                </Grid>

                <!--
                    Exactly four cards from the same live Catalog source. UniformGrid lets
                    WPF distribute width without an ActualWidth binding/layout feedback loop.
                -->
                <ItemsControl
                    x:Name="RecommendationCards"
                    Grid.Row="2"
                    Height="190"
                    AlternationCount="4"
                    ClipToBounds="True"
                    ItemTemplate="{StaticResource RecommendationCardTemplate}"
                    Style="{StaticResource HomeFeaturedVisibilityStyle}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="4" Rows="1" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="HorizontalAlignment" Value="Stretch" />
                            <Setter Property="VerticalAlignment" Value="Stretch" />
                            <Setter Property="Margin" Value="0,0,8,0" />
                            <Style.Triggers>
                                <Trigger Property="ItemsControl.AlternationIndex" Value="3">
                                    <Setter Property="Margin" Value="0" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                </ItemsControl>

                <!--  Catalog block. It intentionally reuses OldInstanceForm and the Catalog filter model.  -->
                <Grid
                    x:Name="CatalogBlock"
                    Grid.Row="3"
                    Margin="0,38,0,0"
                    SizeChanged="CatalogBlock_SizeChanged">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ElementName=HomeTabs, Path=SelectedIndex}" Value="1">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ElementName=HomeTabs, Path=SelectedIndex}" Value="2">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="326" />
                    </Grid.ColumnDefinitions>

                    <!--
                        The filter has natural height. While scrolling, code-behind translates only this card
                        after its header reaches the viewport top, creating a sticky sidebar without a full-height slab.
                    -->
                    <Border
                        x:Name="FilterStickyAnchor"
                        Grid.Column="1"
                        Width="1"
                        Height="1"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Opacity="0" />

                    <Border
                        x:Name="FilterPanel"
                        Grid.Column="1"
                        Margin="20,0,0,0"
                        Padding="14"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Top"
                        Panel.ZIndex="20"
                        Background="{DynamicResource InstancesFilterSolidColorBrush}"
                        BorderBrush="{DynamicResource InstancesFilterBorderSolidColorBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Visibility="{Binding IsFilterPanelVisible, Converter={converters:BooleanToVisibilityConverter}}">
                        <Border.RenderTransform>
                            <TranslateTransform x:Name="FilterStickyTranslate" Y="0" />
                        </Border.RenderTransform>
                        <StackPanel>
                            <controls:SearchBox
                                Height="38"
                                MinWidth="0"
                                HorizontalAlignment="Stretch"
                                Placeholder="{DynamicResource Search}"
                                SearchCommand="{Binding Catalog.SearchCommand}"
                                Text="{Binding Catalog.Model.SearchFilter, UpdateSourceTrigger=PropertyChanged}" />

                            <Grid Margin="0,16,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel
                                    Margin="16,0,0,0"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal">
                                    <Viewbox
                                        Width="15"
                                        Height="15"
                                        Margin="0,0,8,0">
                                        <Path
                                            extensions:PathExtensions.StringKeyData="Filter"
                                            Fill="{DynamicResource PrimaryForegroundSolidColorBrush}"
                                            Stretch="Uniform" />
                                    </Viewbox>
                                    <TextBlock
                                        FontSize="13"
                                        Foreground="{DynamicResource PrimaryForegroundSolidColorBrush}"
                                        Text="{DynamicResource Filters}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <controls:AdvancedButton
                                        Width="28"
                                        Height="28"
                                        Margin="4,0,0,0"
                                        FontSize="11"
                                        Command="{Binding RefreshCatalogCommand}"
                                        IconData="{DynamicResource PDReload}"
                                        Style="{StaticResource sm-icon-button}"
                                        ToolTip="{DynamicResource RefreshCatalog}" />
                                    <controls:AdvancedButton
                                        Width="28"
                                        Height="28"
                                        Margin="4,0,0,0"
                                        FontSize="11"
                                        Command="{Binding ToggleFilterPanelCommand}"
                                        IconData="{DynamicResource PDClose}"
                                        Style="{StaticResource sm-icon-button}"
                                        ToolTip="{DynamicResource CloseFilters}" />
                                </StackPanel>
                            </Grid>

                            <Border
                                Margin="0,12,0,0"
                                BorderBrush="{DynamicResource SeparateSolidColorBrush}"
                                BorderThickness="0,1,0,0" />

                            <!--  SOURCE  -->
                            <Grid Margin="0,13,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    FontSize="11.5"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource SecondaryForegroundSolidColorBrush}"
                                    Text="{DynamicResource Source}" />
                                <TextBlock
                                    Grid.Column="1"
                                    extensions:TextBlockExtensions.TextByKey="{Binding Catalog.Model.FilterPanel.SelectedSource.TranslateKey}"
                                    FontSize="12.5"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource PrimaryForegroundSolidColorBrush}" />
                            </Grid>
                            <Border
                                Margin="0,7,0,0"
                                Padding="3"
                                Background="{DynamicResource SecondarySolidColorBrush}"
                                BorderBrush="{DynamicResource SeparateSolidColorBrush}"
                                BorderThickness="1"
                                CornerRadius="5">
                                <ListView
                                    Background="Transparent"
                                    BorderThickness="0"
                                    ItemsSource="{Binding Catalog.Model.FilterPanel.Sources}"
                                    SelectedItem="{Binding Catalog.Model.FilterPanel.SelectedSource}">
                                    <ListView.ItemContainerStyle>
                                        <Style BasedOn="{StaticResource HomeSourceIconListItem}" TargetType="{x:Type ListViewItem}">
                                            <Setter Property="Content" Value="{Binding Value, Converter={converters:ToStringConverter}}" />
                                        </Style>
                                    </ListView.ItemContainerStyle>
                                    <ListView.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel IsItemsHost="True" />
                                        </ItemsPanelTemplate>
                                    </ListView.ItemsPanel>
                                </ListView>
                            </Border>

                            <!--  SORTING  -->
                            <StackPanel Margin="0,16,0,0" Visibility="{Binding Catalog.Model.FilterPanel.SortByParams.Count, Converter={converters:CountToVisibilityConverter}}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        FontSize="11.5"
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource SecondaryForegroundSolidColorBrush}"
                                        Text="{DynamicResource Sorting}" />
                                    <TextBlock
                                        Grid.Column="1"
                                        extensions:TextBlockExtensions.TextByKey="{Binding Catalog.Model.FilterPanel.SelectedSortByParam.TranslateKey}"
                                        FontSize="12.5"
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource PrimaryForegroundSolidColorBrush}" />
                                </Grid>
                                <Border
                                    Margin="0,7,0,0"
                                    Padding="3"
                                    Background="{DynamicResource SecondarySolidColorBrush}"
                                    BorderBrush="{DynamicResource SeparateSolidColorBrush}"
                                    BorderThickness="1"
                                    CornerRadius="5">
                                    <ListView
                                        Background="Transparent"
                                        BorderThickness="0"
                                        ItemsSource="{Binding Catalog.Model.FilterPanel.SortByParams}"
                                        SelectedItem="{Binding Catalog.Model.FilterPanel.SelectedSortByParam}">
                                        <ListView.ItemContainerStyle>
                                            <Style BasedOn="{StaticResource HomeSortIconListItem}" TargetType="{x:Type ListViewItem}">
                                                <Setter Property="Content" Value="{Binding TranslateKey}" />
                                            </Style>
                                        </ListView.ItemContainerStyle>
                                        <ListView.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel IsItemsHost="True" />
                                            </ItemsPanelTemplate>
                                        </ListView.ItemsPanel>
                                    </ListView>
                                </Border>
                            </StackPanel>

                            <!--  VERSION  -->
                            <StackPanel Margin="0,16,0,0">
                                <TextBlock
                                    FontSize="11.5"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource SecondaryForegroundSolidColorBrush}"
                                    Text="{DynamicResource Version}" />
                                <ComboBox
                                    Margin="0,7,0,0"
                                    ItemsSource="{Binding Catalog.Model.FilterPanel.VersionCollectionViewSource.View}"
                                    SelectedValue="{Binding Catalog.Model.FilterPanel.SelectedVersion, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>

                            <!--  CATEGORIES  -->
                            <StackPanel Margin="0,16,0,0">
                                <TextBlock
                                    FontSize="11.5"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource SecondaryForegroundSolidColorBrush}"
                                    Text="{DynamicResource Categories}" />
                                <core:If Margin="0,4,0,0" Condition="{Binding Catalog.Model.FilterPanel.IsCategoryLoading}">
                                    <core:If.False>
                                        <Grid Height="96">
                                            <controls:CircleLoader
                                                Width="24"
                                                Height="24"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                IsActive="{Binding Catalog.Model.FilterPanel.IsCategoryLoading}" />
                                        </Grid>
                                    </core:If.False>
                                    <core:If.True>
                                        <ItemsControl ItemsSource="{Binding Catalog.Model.FilterPanel.AvailableCategories}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel IsItemsHost="True" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type objects:CategoryBase}">
                                                    <ToggleButton
                                                        Margin="0,4,4,0"
                                                        Command="{Binding DataContext.Catalog.SelectCategoryCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                        CommandParameter="{Binding}"
                                                        Content="{Binding Name}"
                                                        Style="{StaticResource CategoryToggleButton}" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </core:If.True>
                                </core:If>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Grid Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <controls:AdvancedButton
                            Width="92"
                            Height="32"
                            Margin="0,0,0,12"
                            HorizontalAlignment="Right"
                            Command="{Binding ToggleFilterPanelCommand}"
                            Text="{DynamicResource Filters}"
                            Style="{StaticResource sm-default}"
                            Visibility="{Binding IsFilterPanelVisible, Converter={converters:NegativeBooleanToVisibilityConverter}}" />

                        <!--
                            Keep the list area stable while the remote source is changing.
                            The old cards fade down, the lightweight overlay fades in, and the
                            new source fades back in after CatalogModel.IsLoading becomes false.
                        -->
                        <Grid Grid.Row="1" MinHeight="390">
                            <Grid x:Name="CatalogDataHost">
                                <core:If Condition="{Binding DisplayedCatalogInstances, Converter={converters:IsCollectionEmptyConverter}}">
                                    <core:If.True>
                                        <!-- Reuse the existing PageCurtains composition without introducing another control. -->
                                        <Border
                                            MinHeight="340"
                                            Margin="0,0,0,20"
                                            Padding="32,40"
                                            Background="{DynamicResource PrimarySolidColorBrush}"
                                            BorderBrush="{DynamicResource InstancesFilterBorderSolidColorBrush}"
                                            BorderThickness="1"
                                            CornerRadius="10"
                                            Visibility="{Binding Catalog.Model.IsLoading, Converter={converters:NegativeBooleanToVisibilityConverter}}">
                                            <StackPanel
                                                MaxWidth="480"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center">
                                                <Border
                                                    Width="76"
                                                    Height="76"
                                                    HorizontalAlignment="Center"
                                                    Background="{DynamicResource SecondarySolidColorBrush}"
                                                    CornerRadius="16">
                                                    <Viewbox
                                                        Width="36"
                                                        Height="36"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center">
                                                        <Path
                                                            extensions:PathExtensions.StringKeyData="Catalog"
                                                            Fill="{DynamicResource ActivitySolidColorBrush}"
                                                            Stretch="Uniform" />
                                                    </Viewbox>
                                                </Border>
                                                <TextBlock
                                                    Margin="0,22,0,0"
                                                    HorizontalAlignment="Center"
                                                    FontSize="22"
                                                    FontWeight="SemiBold"
                                                    Foreground="{DynamicResource ActivitySolidColorBrush}"
                                                    Text="{DynamicResource CatalogEmptyTitle}"
                                                    TextAlignment="Center" />
                                                <TextBlock
                                                    Margin="0,10,0,0"
                                                    FontSize="14"
                                                    Foreground="{DynamicResource SecondaryForegroundSolidColorBrush}"
                                                    Text="{DynamicResource CatalogEmptyDescription}"
                                                    TextAlignment="Center"
                                                    TextWrapping="Wrap" />
                                                <controls:AdvancedButton
                                                    Height="36"
                                                    MinWidth="175"
                                                    Margin="0,24,0,0"
                                                    HorizontalAlignment="Center"
                                                    Command="{Binding RefreshCatalogCommand}"
                                                    IconData="{DynamicResource PDReload}"
                                                    Text="{DynamicResource RefreshCatalog}"
                                                    Style="{StaticResource sm-default}" />
                                            </StackPanel>
                                        </Border>
                                    </core:If.True>
                                    <core:If.False>
                                        <StackPanel>
                                            <ItemsControl
                                                x:Name="CatalogInstanceList"
                                                HorizontalAlignment="Stretch"
                                                ItemTemplate="{StaticResource CatalogInstanceTemplate}"
                                                ItemsSource="{Binding DisplayedCatalogInstances}"
                                                ScrollViewer.CanContentScroll="True">
                                                <ItemsControl.ItemContainerStyle>
                                                    <Style TargetType="ContentPresenter">
                                                        <Setter Property="HorizontalAlignment" Value="Stretch" />
                                                    </Style>
                                                </ItemsControl.ItemContainerStyle>
                                            </ItemsControl>

                                            <controls:Paginator
                                                x:Name="HomePaginator"
                                                Margin="0"
                                                PageChanged="HomePaginator_PageChanged"
                                                CurrentPageIndex="{Binding Catalog.Model.CurrentPageIndex, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                                PageCount="{Binding Catalog.Model.PageCount, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
                                        </StackPanel>
                                    </core:If.False>
                                </core:If>
                            </Grid>

                            <!-- Compact feedback, without hiding the previous page or
                                 changing the height of the scrollable list. -->
                            <Border
                                x:Name="CatalogLoadingOverlay"
                                Panel.ZIndex="30"
                                Width="212"
                                Height="42"
                                Margin="0,8,0,0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Top"
                                IsHitTestVisible="False"
                                Background="{DynamicResource PrimarySolidColorBrush}"
                                BorderBrush="{DynamicResource InstanceFormBorderSolidColorBrush}"
                                BorderThickness="1"
                                CornerRadius="7"
                                Visibility="{Binding Catalog.Model.IsLoading, Converter={converters:BooleanToVisibilityConverter}}">
                                <StackPanel
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal">
                                    <controls:CircleLoader
                                        Width="20"
                                        Height="20"
                                        IsActive="{Binding Catalog.Model.IsLoading}" />
                                    <TextBlock
                                        Margin="10,0,0,0"
                                        VerticalAlignment="Center"
                                        FontSize="12"
                                        Foreground="{DynamicResource PrimaryForegroundSolidColorBrush}"
                                        Text="{DynamicResource CatalogLoading}" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>
                </Grid>

                <!-- Local placeholders: tabs switch content without navigating away from Home. -->
                <Border
                    Grid.Row="1"
                    Grid.RowSpan="3"
                    MinHeight="420"
                    Margin="0,18,0,0"
                    Padding="32,56"
                    Background="{DynamicResource PrimarySolidColorBrush}"
                    BorderBrush="{DynamicResource InstancesFilterBorderSolidColorBrush}"
                    BorderThickness="1"
                    CornerRadius="10">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ElementName=HomeTabs, Path=SelectedIndex}" Value="1">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ElementName=HomeTabs, Path=SelectedIndex}" Value="2">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel MaxWidth="460" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Border
                            Width="76"
                            Height="76"
                            HorizontalAlignment="Center"
                            Background="{DynamicResource SecondarySolidColorBrush}"
                            CornerRadius="16">
                            <Viewbox Width="36" Height="36" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Path
                                    extensions:PathExtensions.StringKeyData="Clock"
                                    Fill="{DynamicResource ActivitySolidColorBrush}"
                                    Stretch="Uniform" />
                            </Viewbox>
                        </Border>
                        <TextBlock
                            Margin="0,22,0,0"
                            HorizontalAlignment="Center"
                            FontSize="22"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource ActivitySolidColorBrush}"
                            extensions:TextBlockExtensions.TextByKey="{Binding ElementName=HomeTabs, Path=SelectedItem.Header}"
                            TextAlignment="Center" />
                        <TextBlock
                            Margin="0,10,0,0"
                            FontSize="14"
                            Foreground="{DynamicResource SecondaryForegroundSolidColorBrush}"
                            Text="{DynamicResource HomeSectionComingSoonDescription}"
                            TextAlignment="Center"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </Grid>
        </ScrollViewer>
        <!-- Fade only the catalog's left column. The sticky filter column must stay clear.
             These grid columns mirror CatalogBlock (star + 326px filter) inside Home margins. -->
        <Grid
            Margin="32,0,36,0"
            VerticalAlignment="Top"
            Panel.ZIndex="10"
            IsHitTestVisible="False">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="326" />
            </Grid.ColumnDefinitions>
            <Border
                x:Name="HomeScrollFade"
                Grid.Column="0"
                Height="56"
                VerticalAlignment="Top"
                Background="{DynamicResource PageSolidColorBrush}"
                Opacity="0">
                <Border.OpacityMask>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#FF000000" Offset="0" />
                        <GradientStop Color="#E0000000" Offset="0.4" />
                        <GradientStop Color="#00000000" Offset="1" />
                    </LinearGradientBrush>
                </Border.OpacityMask>
            </Border>
        </Grid>
    </Grid>
</UserControl>
