    <UserControl x:Class="Lexplosion.UI.WPF.Mvvm.Views.Pages.MainContent.NewsHub.Components.NewsItem"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
                 xmlns:local="clr-namespace:Lexplosion.UI.WPF.Mvvm.Views.Pages.MainContent.NewsHub"
                 xmlns:converters="clr-namespace:Lexplosion.UI.WPF.Core.Converters"
                 xmlns:extensions="clr-namespace:Lexplosion.UI.WPF.Extensions"
                 mc:Ignorable="d" 
                 d:DesignHeight="450" d:DesignWidth="800">

        <Border Padding="2"
                Margin="6"
                Height="210"
                Width="216"
                Background="{DynamicResource SeparateSolidColorBrush}"
                CornerRadius="10">

            <Border Background="{DynamicResource PrimarySolidColorBrush}"
                    CornerRadius="8"
                    ClipToBounds="True">

                <Grid >
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" 
                            CornerRadius="10,10,0,0">
                        <Border.Background>
                            <ImageBrush ImageSource="/Mvvm/Views/Pages/MainContent/NewsHub/Components/test-photo.png" 
                                    Stretch="UniformToFill"/>
                        </Border.Background>
                    </Border>

                    <Grid Grid.Row="1" Margin="5">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   Text="{Binding Title}"
                                   FontWeight="Medium"
                                   FontSize="16"
                                   Margin="0,0,0,4"
                                   Foreground="{DynamicResource PrimaryForegroundSolidColorBrush}"/>

                        <TextBlock Grid.Row="1"
                                   Text="{Binding Description}"
                                   FontWeight="Regular"
                                   FontSize="14"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource SecondaryForegroundSolidColorBrush}"/>

                        <Border Grid.Row="2"
                            Height="1"
                            Margin="0,6"
                            Background="#484848"/>

                        <Grid Grid.Row="3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0"
                                        Orientation="Horizontal"
                                        VerticalAlignment="Center">

                                <Viewbox Width="14" Height="14">
                                    <Path
                                        extensions:PathExtensions.StringKeyData="Calendar"
                                        Fill="{DynamicResource LatestForegroundSolidColorBrush}"
                                        Stretch="Uniform"/>
                                </Viewbox>

                                <TextBlock
                                        Text="{Binding Date, StringFormat=dd.MM.yyyy}"
                                        Margin="4,0,0,0"
                                        FontSize="12"
                                        VerticalAlignment="Center"
                                        Foreground="{DynamicResource LatestForegroundSolidColorBrush}"/>
                            </StackPanel>

                            <TextBlock Grid.Column="1"
                                       Text="{Binding Author}"
                                       FontSize="12"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Right"
                                       Foreground="{DynamicResource LatestForegroundSolidColorBrush}"/>
                        </Grid>

                    </Grid>

                </Grid>
        </Border>
    </Border>


</UserControl>
