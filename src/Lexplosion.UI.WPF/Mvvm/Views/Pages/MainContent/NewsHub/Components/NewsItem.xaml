<UserControl x:Class="Lexplosion.UI.WPF.Mvvm.Views.Pages.MainContent.NewsHub.Components.NewsItem"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Lexplosion.UI.WPF.Mvvm.Views.Pages.MainContent.NewsHub"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">

    <Border Padding="5,2,5,4"
            Margin="3"
            Height="256"
            Width="256"
            Background="{DynamicResource SeparateSolidColorBrush}"
            CornerRadius="10"
            ClipToBounds="True">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" 
                    CornerRadius="10,10,0,0">
                    <Border.Background>
                        <ImageBrush ImageSource="/Mvvm/Views/Pages/MainContent/NewsHub/Components/test-photo.png" 
                            Stretch="UniformToFill"/>
                    </Border.Background>
            </Border>



            <Grid Grid.Row="1" Margin="5">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="Ивент на ПОДПИСКИ"
                           TextAlignment="Center"
                           FontSize="16"
                           Margin="0,0,0,4"
                           Foreground="{DynamicResource PrimaryForegroundSolidColorBrush}"/>

                <TextBlock Grid.Row="1"
                           Text="24 мая в 10 утра по московскому времени будет конкурс среди игроков лаунчера лексплосион..."
                           TextAlignment="Center"
                           FontSize="14"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource SecondaryForegroundSolidColorBrush}"/>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="(Новое)"
                               Foreground="{DynamicResource ActivitySolidColorBrush}"/>

                    <TextBlock Grid.Column="1"
                               Text="19.04.2026"
                               HorizontalAlignment="Right"
                               Foreground="{DynamicResource LatestForegroundSolidColorBrush}"/>
                </Grid>

            </Grid>

        </Grid>
    </Border>


</UserControl>
