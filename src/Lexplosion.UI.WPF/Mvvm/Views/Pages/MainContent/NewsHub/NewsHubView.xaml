<UserControl
    x:Class="Lexplosion.UI.WPF.Mvvm.Views.Pages.MainContent.NewsHub.NewsHubView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:components="clr-namespace:Lexplosion.UI.WPF.Mvvm.Views.Pages.MainContent.NewsHub.Components"
    xmlns:controls="clr-namespace:Lexplosion.UI.WPF.Controls"
    xmlns:converters="clr-namespace:Lexplosion.UI.WPF.Core.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Lexplosion.UI.WPF.Mvvm.Views.Pages.MainContent.NewsHub"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:newshub="clr-namespace:Lexplosion.UI.WPF.Mvvm.ViewModels.MainContent.NewsHub"
    d:DataContext="{d:DesignInstance Type=newshub:NewsHubViewModel}"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <Grid Margin="0,36,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border
            x:Name="HeaderBorder"
            Background="Transparent"
            BorderBrush="{DynamicResource SeparateSolidColorBrush}"
            BorderThickness="0,0,0,2">
            <StackPanel Margin="36,0,0,16" Orientation="Horizontal">


                <Button
                    x:Name="CloseArticleButton"
                    Height="16"
                    Margin="0,2,0,0"
                    VerticalAlignment="Center"
                    Command="{Binding BackCommand}"
                    Content="LeftBackArrow"
                    Cursor="Hand"
                    IsCancel="True"
                    Style="{StaticResource x32IconButtonWithHover}">
                    <Button.ToolTip>
                        <controls:AdvancedToolTip
                            Background="Transparent"
                            BorderThickness="0"
                            Placement="Right"
                            PlacementRectangle="0,-50,0,0">

                            <TextBlock
                                Padding="15,14,15,14"
                                VerticalAlignment="Center"
                                FontSize="12"
                                FontWeight="Medium"
                                Foreground="{DynamicResource CheckBoxMarkSolidColorBrush}"
                                Text="{DynamicResource CloseArticleButtonTooltip}" />
                        </controls:AdvancedToolTip>
                    </Button.ToolTip>
                </Button>

                <TextBlock
                    Grid.Row="0"
                    Margin="4,0,0,0"
                    FontSize="24"
                    FontWeight="Bold"
                    Foreground="{DynamicResource PrimaryForegroundSolidColorBrush}"
                    Text="{DynamicResource NewsTitle}" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="1">

            <controls:CircleLoader
                Width="45"
                Height="45"
                Margin="0,-64,0,0"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                CornerRadius="5"
                IsActive="{Binding Model.Items, Converter={converters:IsCollectionEmptyConverter}}" />

            <ScrollViewer ScrollChanged="ScrollViewer_ScrollChanged">
                <ItemsControl Padding="30,0,0,0" ItemsSource="{Binding Model.Items}">

                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Margin="0,0,0,16" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <components:NewsPreviewView />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>

                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
