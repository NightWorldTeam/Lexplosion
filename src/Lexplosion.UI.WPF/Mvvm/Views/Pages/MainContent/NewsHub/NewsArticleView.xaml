<UserControl
    x:Class="Lexplosion.UI.WPF.Mvvm.Views.Pages.MainContent.NewsHub.NewsArticleView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Lexplosion.UI.WPF.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ext="clr-namespace:MarkdownWPF.Extensions;assembly=MarkdownWPF"
    xmlns:extensions="clr-namespace:Lexplosion.UI.WPF.Extensions"
    xmlns:local="clr-namespace:Lexplosion.UI.WPF.Mvvm.Views.Pages.MainContent.NewsHub"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:md="clr-namespace:MarkdownWPF;assembly=MarkdownWPF"
    xmlns:newshub="clr-namespace:Lexplosion.UI.WPF.Mvvm.ViewModels.MainContent.NewsHub"
    d:DataContext="{d:DesignInstance Type=newshub:NewsArticleViewModel}"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">

    <Grid>

        <Button
            x:Name="CloseArticleButton"
            Height="16"
            Margin="8,58,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Command="{Binding BackCommand}"
            Content="LeftBackArrow"
            Cursor="Hand"
            IsCancel="True"
            Style="{StaticResource x32IconButtonWithHover}">
            <Button.ToolTip>
                <controls:AdvancedToolTip
                    Background="Transparent"
                    BorderThickness="0"
                    Placement="Right"
                    PlacementRectangle="0,-50,0,0">

                    <TextBlock
                        Padding="15,14,15,14"
                        VerticalAlignment="Center"
                        FontSize="12"
                        FontWeight="Medium"
                        Foreground="{DynamicResource CheckBoxMarkSolidColorBrush}"
                        Text="{DynamicResource CloseArticleButtonTooltip}" />
                </controls:AdvancedToolTip>
            </Button.ToolTip>
        </Button>

        <Grid Margin="32,16,0,0" Background="Transparent">

            <ScrollViewer
                Grid.Column="1"
                Padding="16,16,16,0"
                Background="Transparent"
                VerticalScrollBarVisibility="Auto">
                <md:MarkdownViewer
                    Margin="0,0,0,16"
                    IsScrollViewerEnabled="False"
                    Markdown="{Binding Model.Context, UpdateSourceTrigger=PropertyChanged}"
                    Pipeline="{Binding Model.HtmlPipeline}"
                    StyleResourceMode="Dynamic" />
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
