<UserControl
    x:Class="Lexplosion.UI.WPF.Mvvm.Views.Pages.MainContent.NewsHub.NewsArticleView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Lexplosion.UI.WPF.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ext="clr-namespace:MarkdownWPF.Extensions;assembly=MarkdownWPF"
    xmlns:extensions="clr-namespace:Lexplosion.UI.WPF.Extensions"
    xmlns:local="clr-namespace:Lexplosion.UI.WPF.Mvvm.Views.Pages.MainContent.NewsHub"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:md="clr-namespace:MarkdownWPF;assembly=MarkdownWPF"
    xmlns:newshub="clr-namespace:Lexplosion.UI.WPF.Mvvm.ViewModels.MainContent.NewsHub"
    d:DataContext="{d:DesignInstance Type=newshub:NewsArticleViewModel}"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">

    <UserControl.Resources>
        <!--  Paragraph  -->
        <Style x:Key="MarkdownParagraphStyleBase" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource SecondaryForegroundSolidColorBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,0,0,16" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="LineHeight" Value="21" />
        </Style>

        <!--  Headings  -->
        <Style x:Key="MarkdownHeading1StyleBase" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,12,0,8" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style
            x:Key="MarkdownHeading2StyleBase"
            BasedOn="{StaticResource MarkdownHeading1StyleBase}"
            TargetType="TextBlock">
            <Setter Property="FontSize" Value="24" />
            <Setter Property="Padding" Value="0,0,0,6" />
        </Style>
        <Style
            x:Key="MarkdownHeading3StyleBase"
            BasedOn="{StaticResource MarkdownHeading1StyleBase}"
            TargetType="TextBlock">
            <Setter Property="FontSize" Value="20" />
        </Style>
        <Style
            x:Key="MarkdownHeading4StyleBase"
            BasedOn="{StaticResource MarkdownHeading1StyleBase}"
            TargetType="TextBlock">
            <Setter Property="FontSize" Value="16" />
        </Style>
        <Style
            x:Key="MarkdownHeading5StyleBase"
            BasedOn="{StaticResource MarkdownHeading1StyleBase}"
            TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
        </Style>
        <Style
            x:Key="MarkdownHeading6StyleBase"
            BasedOn="{StaticResource MarkdownHeading1StyleBase}"
            TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
        </Style>

        <!--  Code block  -->
        <Style x:Key="MarkdownCodeBlockBorderStyleBase" TargetType="Border">
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="Margin" Value="0,0,0,16" />
        </Style>
        <Style x:Key="MarkdownCodeBlockStyleBase" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="LineHeight" Value="19" />
        </Style>

        <!--  Thematic break (Разделитель)  -->
        <Style x:Key="MarkdownThematicBreakStyleBase" TargetType="Border">
            <Setter Property="BorderThickness" Value="0,0,0,2" />
            <Setter Property="Margin" Value="0,0,0,24" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
        </Style>

        <!--  Lists  -->
        <Style x:Key="MarkdownListStyleBase" TargetType="StackPanel">
            <Setter Property="Margin" Value="0,0,0,0" />
        </Style>
        <Style x:Key="MarkdownListItemStyleBase" TargetType="Grid">
            <Setter Property="Margin" Value="0,0,0,0" />
        </Style>
        <Style x:Key="MarkdownListItemMarkerStyleBase" TargetType="TextBlock">
            <Setter Property="Margin" Value="16,0,4,0" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>

        <!--  Tables  -->
        <Style x:Key="MarkdownTableStyleBase" TargetType="Grid">
            <Setter Property="Margin" Value="0,10,0,16" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Style.Triggers>
                <Trigger Property="ext:MarkdownProperties.IsLastChild" Value="True">
                    <Setter Property="Margin" Value="0,10,0,0" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="MarkdownTableCellStyleBase" TargetType="Border">
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="13,6" />
        </Style>

        <Style
            x:Key="MarkdownTableHeaderCellStyleBase"
            BasedOn="{StaticResource MarkdownTableCellStyleBase}"
            TargetType="Border">
            <Setter Property="TextBlock.FontWeight" Value="Bold" />
        </Style>

        <!--  Blockquote  -->
        <Style x:Key="MarkdownBlockquoteStyleBase" TargetType="Border">
            <Setter Property="BorderThickness" Value="4,0,0,0" />
            <Setter Property="Padding" Value="16,4,0,4" />
            <Setter Property="Margin" Value="0,0,0,16" />
            <Setter Property="TextBlock.FontStyle" Value="Italic" />
            <Style.Triggers>
                <Trigger Property="ext:MarkdownProperties.IsLastChild" Value="True">
                    <Setter Property="Margin" Value="0,0,0,0" />
                </Trigger>
            </Style.Triggers>
        </Style>


        <!--    -->
        <!--  Theme Integration (Интеграция с темой Open Space)  -->
        <!--    -->

        <!--  Block elements  -->
        <Style
            x:Key="MarkdownParagraphStyle"
            BasedOn="{StaticResource MarkdownParagraphStyleBase}"
            TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundSolidColorBrush}" />
        </Style>

        <!--  Headings (Заголовки используют основной белый цвет темы)  -->
        <Style
            x:Key="MarkdownHeading1Style"
            BasedOn="{StaticResource MarkdownHeading1StyleBase}"
            TargetType="TextBlock">
            <Setter Property="FontSize" Value="32" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundSolidColorBrush}" />
        </Style>
        <Style
            x:Key="MarkdownHeading2Style"
            BasedOn="{StaticResource MarkdownHeading2StyleBase}"
            TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundSolidColorBrush}" />
        </Style>
        <Style
            x:Key="MarkdownHeading3Style"
            BasedOn="{StaticResource MarkdownHeading3StyleBase}"
            TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundSolidColorBrush}" />
        </Style>
        <Style
            x:Key="MarkdownHeading4Style"
            BasedOn="{StaticResource MarkdownHeading4StyleBase}"
            TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundSolidColorBrush}" />
        </Style>
        <Style
            x:Key="MarkdownHeading5Style"
            BasedOn="{StaticResource MarkdownHeading5StyleBase}"
            TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundSolidColorBrush}" />
        </Style>
        <Style
            x:Key="MarkdownHeading6Style"
            BasedOn="{StaticResource MarkdownHeading6StyleBase}"
            TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource LatestForegroundSolidColorBrush}" />
        </Style>

        <!--  Code Block (Использует темную подложку тегов темы)  -->
        <Style
            x:Key="MarkdownCodeBlockBorderStyle"
            BasedOn="{StaticResource MarkdownCodeBlockBorderStyleBase}"
            TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource TagsColorBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SeparateSolidColorBrush}" />
        </Style>
        <Style
            x:Key="MarkdownCodeBlockStyle"
            BasedOn="{StaticResource MarkdownCodeBlockStyleBase}"
            TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundSolidColorBrush}" />
        </Style>

        <!--  Thematic Break (Линия-разделитель)  -->
        <Style
            x:Key="MarkdownThematicBreakStyle"
            BasedOn="{StaticResource MarkdownThematicBreakStyleBase}"
            TargetType="Border">
            <Setter Property="BorderBrush" Value="{DynamicResource SeparateSolidColorBrush}" />
        </Style>

        <Style
            x:Key="MarkdownListStyle"
            BasedOn="{StaticResource MarkdownListStyleBase}"
            TargetType="StackPanel" />

        <Style
            x:Key="MarkdownListItemStyle"
            BasedOn="{StaticResource MarkdownListItemStyleBase}"
            TargetType="Grid" />

        <!--  List Marker (Маркеры выделены неоновым синим акцентом)  -->
        <Style
            x:Key="MarkdownListItemMarkerStyle"
            BasedOn="{StaticResource MarkdownListItemMarkerStyleBase}"
            TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource ActivitySolidColorBrush}" />
        </Style>

        <!--  Tables  -->
        <Style
            x:Key="MarkdownTableStyle"
            BasedOn="{StaticResource MarkdownTableStyleBase}"
            TargetType="Grid" />

        <Style
            x:Key="MarkdownTableCellStyle"
            BasedOn="{StaticResource MarkdownTableCellStyleBase}"
            TargetType="Border">
            <Setter Property="BorderBrush" Value="{DynamicResource SeparateSolidColorBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="TextBlock.Foreground" Value="{DynamicResource PrimaryForegroundSolidColorBrush}" />
        </Style>

        <Style
            x:Key="MarkdownTableHeaderCellStyle"
            BasedOn="{StaticResource MarkdownTableHeaderCellStyleBase}"
            TargetType="Border">
            <Setter Property="BorderBrush" Value="{DynamicResource SeparateSolidColorBrush}" />
            <Setter Property="Background" Value="{DynamicResource TagsColorBrush}" />
            <Setter Property="TextBlock.Foreground" Value="{DynamicResource PrimaryForegroundSolidColorBrush}" />
        </Style>

        <!--  BlockQuote (Цитаты оформлены границей и светло-серым текстом)  -->
        <Style
            x:Key="MarkdownBlockQuoteStyle"
            BasedOn="{StaticResource MarkdownBlockquoteStyleBase}"
            TargetType="Border">
            <Setter Property="BorderBrush" Value="{DynamicResource SeparateSolidColorBrush}" />
            <Setter Property="TextBlock.Foreground" Value="{DynamicResource SecondaryForegroundSolidColorBrush}" />
        </Style>


        <!--    -->
        <!--  Inline Elements (Инлайновые элементы)  -->
        <!--    -->

        <!--  Code Inline  -->
        <Style x:Key="MarkdownCodeInlineStyle" TargetType="Run">
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="Background" Value="{DynamicResource TagsColorBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundSolidColorBrush}" />
        </Style>

        <!--  Hyperlinks (Ссылки светятся неоновым синим акцентом при наведении)  -->
        <Style x:Key="MarkdownLinkStyle" TargetType="Hyperlink">
            <Setter Property="Foreground" Value="{DynamicResource ActivitySolidColorBrush}" />
            <Setter Property="TextDecorations" Value="None" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="TextDecorations" Value="Underline" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!--  Emphasis (Bold / Italic)  -->
        <Style x:Key="MarkdownStrongStyle" TargetType="Span">
            <Setter Property="FontWeight" Value="Bold" />
        </Style>

        <Style x:Key="MarkdownEmphasisStyle" TargetType="Span">
            <Setter Property="FontStyle" Value="Italic" />
        </Style>

        <!--  Strikethrough (Зачеркнутый)  -->
        <Style x:Key="MarkdownStrikethroughStyle" TargetType="Span">
            <Setter Property="TextDecorations" Value="Strikethrough" />
        </Style>

        <!--  Mark (Подсветка использует полупрозрачный синий акцент)  -->
        <Style x:Key="MarkdownMarkStyle" TargetType="Span">
            <Setter Property="Background" Value="{DynamicResource KeyboardNavigationSolidColorBrush}" />
        </Style>

        <!--  Subscript (Подстрочный индекс)  -->
        <Style x:Key="MarkdownSubscriptStyle" TargetType="Span">
            <Setter Property="BaselineAlignment" Value="Subscript" />
            <Setter Property="FontSize" Value="10" />
        </Style>

        <!--  Superscript (Надстрочный индекс)  -->
        <Style x:Key="MarkdownSuperscriptStyle" TargetType="Span">
            <Setter Property="BaselineAlignment" Value="Superscript" />
            <Setter Property="FontSize" Value="10" />
        </Style>

        <!--  Inserted (Вставленный текст)  -->
        <Style x:Key="MarkdownInsertedStyle" TargetType="Span">
            <Setter Property="TextDecorations" Value="Underline" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundSolidColorBrush}" />
        </Style>
    </UserControl.Resources>

    <Grid>

        <Button
            x:Name="CloseArticleButton"
            Height="16"
            Margin="8,58,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Command="{Binding BackCommand}"
            Content="LeftBackArrow"
            Cursor="Hand"
            IsCancel="True"
            Style="{StaticResource x32IconButtonWithHover}">
            <Button.ToolTip>
                <controls:AdvancedToolTip
                    Background="Transparent"
                    BorderThickness="0"
                    Placement="Right"
                    PlacementRectangle="0,-50,0,0">

                    <TextBlock
                        Padding="15,14,15,14"
                        VerticalAlignment="Center"
                        FontSize="12"
                        FontWeight="Medium"
                        Foreground="{DynamicResource CheckBoxMarkSolidColorBrush}"
                        Text="{DynamicResource CloseArticleButtonTooltip}" />
                </controls:AdvancedToolTip>
            </Button.ToolTip>
        </Button>

        <Grid Margin="32,16,0,0" Background="Transparent">

            <ScrollViewer
                Grid.Column="1"
                Padding="16,16,16,0"
                Background="Transparent"
                VerticalScrollBarVisibility="Auto">
                <md:MarkdownViewer
                    Margin="0,0,0,16"
                    IsScrollViewerEnabled="False"
                    Markdown="{Binding Model.Context, UpdateSourceTrigger=PropertyChanged}"
                    Pipeline="{Binding Model.HtmlPipeline}"
                    StyleResourceMode="Dynamic" />
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
