<UserControl
    x:Class="Lexplosion.UI.WPF.Mvvm.Views.Pages.MainContent.InstanceProfile.InstanceProfileOverviewGalleryView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls1="clr-namespace:Lexplosion.UI.WPF.Controls"
    xmlns:converters="clr-namespace:Lexplosion.UI.WPF.Core.Converters"
    xmlns:core="clr-namespace:Lexplosion.UI.WPF.Core"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:instanceprofile="clr-namespace:Lexplosion.UI.WPF.Mvvm.ViewModels.MainContent.InstanceProfile"
    xmlns:local="clr-namespace:Lexplosion.UI.WPF.Mvvm.Views.Pages.MainContent.InstanceProfile"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DataContext="{d:DesignInstance Type=instanceprofile:InstanceProfileOverviewGalleryViewModel}"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">

    <Grid>

        <core:If x:Name="ContainerIf" Condition="{Binding Model.AdditionalData.Images, Converter={converters:IsCollectionEmptyConverter}}">
            <core:If.False>
                <controls1:ImageGallery Margin="35,0,0,0" ItemsSource="{Binding Model.AdditionalData.Images}" OpenImageCommand="{Binding OpenImageCommand}" />
            </core:If.False>

            <core:If.True>
                <controls1:Empty Description="{DynamicResource ThereAreNotImages}" />
            </core:If.True>
        </core:If>

        <controls1:LoadingBoard
            Background="Black"
            BackgroundOpacity="0.3"
            BlurTarget="{Binding ElementName=ContainerIf}"
            IsActive="{Binding Model.IsLoading, UpdateSourceTrigger=PropertyChanged}"
            Placeholder="{DynamicResource ImagesLoading}" />
    </Grid>
</UserControl>
