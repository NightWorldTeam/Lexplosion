<UserControl x:Class="Lexplosion.UI.WPF.Mvvm.Views.Pages.MainContent.InstanceProfile.InstanceProfileOverviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid x:Name="OverviewRoot" ClipToBounds="True"
          Background="{DynamicResource PageSolidColorBrush}"
          SizeChanged="OnOverviewSizeChanged">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition x:Name="DrawerColumn" Width="0"/>
        </Grid.ColumnDefinitions>

        <!-- WebView2 is a native HWND. Reserve a real column for the WPF drawer,
             never draw the drawer over the browser's airspace. -->
        <Grid x:Name="ContentHost" Grid.Column="0" ClipToBounds="True"
              Background="{DynamicResource PageSolidColorBrush}">
            <Grid x:Name="BrowserHost" ClipToBounds="True"
                  Background="{DynamicResource PageSolidColorBrush}"/>

            <!-- In-place loader: no Popup, no CircleLoader template (which rendered
                 the oversized white rotating square on some themes). -->
            <Grid x:Name="LoadingOverlay" Panel.ZIndex="1"
                  Background="{DynamicResource PageSolidColorBrush}"
                  IsHitTestVisible="False" Visibility="Visible">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                            Margin="20" MaxWidth="320">
                    <Grid x:Name="DescriptionLoader" Width="36" Height="36"
                          HorizontalAlignment="Center">
                        <Path Data="M 18,3 A 15,15 0 0 1 33,18"
                              Stroke="{DynamicResource ActivitySolidColorBrush}" StrokeThickness="3.4"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                            <Path.RenderTransform>
                                <RotateTransform CenterX="18" CenterY="18"/>
                            </Path.RenderTransform>
                            <Path.Triggers>
                                <EventTrigger RoutedEvent="Loaded">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                             From="0" To="360" Duration="0:0:0.85"
                                                             RepeatBehavior="Forever"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Path.Triggers>
                        </Path>
                    </Grid>
                    <TextBlock x:Name="BrowserStatus" Text="Загрузка полного описания…"
                               Foreground="{DynamicResource SecondaryForegroundSolidColorBrush}"
                               HorizontalAlignment="Center" TextAlignment="Center"
                               TextWrapping="Wrap" Margin="0,14,0,0" FontSize="13"/>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- Non-modal right drawer. Scrolls separately; no Popup/HwndHost collision. -->
        <Border x:Name="InformationDrawer" Grid.Column="1"
                Visibility="Collapsed" ClipToBounds="True"
                Background="{DynamicResource LayoutTabSolidColorBrush}"
                BorderBrush="{DynamicResource LayoutTabBorderSolidColorBrush}" BorderThickness="1,0,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid Margin="20,16,16,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Информация о сборке" FontSize="17"
                               FontWeight="SemiBold" VerticalAlignment="Center"
                               Foreground="{DynamicResource PrimaryForegroundSolidColorBrush}"/>
                    <!-- Compact drawer closes with the very same button in the tab
                         header that opened it (i -> ×); no displaced second X. -->
                </Grid>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled" Padding="20,2,14,20">
                    <StackPanel>
                        <TextBlock Text="Автор" FontSize="12"
                                   Foreground="{DynamicResource SecondaryForegroundSolidColorBrush}"/>
                        <TextBlock x:Name="DrawerAuthorText" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryForegroundSolidColorBrush}"
                                   TextWrapping="Wrap" Margin="0,5,0,14"/>
                        <Separator Background="{DynamicResource LayoutTabBorderSolidColorBrush}" Margin="0,0,0,14"/>
                        <TextBlock Text="Обновлено" FontSize="12"
                                   Foreground="{DynamicResource SecondaryForegroundSolidColorBrush}"/>
                        <TextBlock x:Name="DrawerUpdatedText" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryForegroundSolidColorBrush}"
                                   TextWrapping="Wrap" Margin="0,5,0,14"/>
                        <Separator Background="{DynamicResource LayoutTabBorderSolidColorBrush}" Margin="0,0,0,14"/>
                        <TextBlock Text="Категории" FontSize="12"
                                   Foreground="{DynamicResource SecondaryForegroundSolidColorBrush}"
                                   Margin="0,0,0,10"/>
                        <ItemsControl x:Name="DrawerCategories">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{DynamicResource LayoutTabBorderSolidColorBrush}" BorderThickness="1"
                                            Background="{DynamicResource LayoutTabSolidColorBrush}" CornerRadius="5"
                                            Padding="9,5" Margin="0,0,6,7">
                                        <TextBlock Text="{Binding}" FontSize="12"
                                                   Foreground="{DynamicResource PrimaryForegroundSolidColorBrush}"/>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
