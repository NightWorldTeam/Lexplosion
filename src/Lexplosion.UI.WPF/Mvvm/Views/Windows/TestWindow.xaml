<Window
    x:Class="Lexplosion.UI.WPF.Mvvm.Views.Windows.TestWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Lexplosion.UI.WPF.Controls"
    xmlns:converters="clr-namespace:Lexplosion.UI.WPF.Core.Converters"
    xmlns:core="clr-namespace:Lexplosion.UI.WPF.Core"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Lexplosion.UI.WPF.Mvvm.Views.Windows"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    x:Name="TestWindowName"
    Title="TestWindow"
    MinWidth="944"
    MinHeight="528"
    MaxWidth="944"
    MaxHeight="528"
    mc:Ignorable="d">
    <Grid
        AllowDrop="True"
        Background="white"
        DragLeave="Grid_DragLeave"
        DragOver="ListViewItem_DragOver">
        <ListBox
            x:Name="CurrentListBox"
            Margin="32,16"
            AllowDrop="True">
            <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type local:ObjModel}">
                    <Border Padding="16,8" Background="Transparent">
                        <TextBlock Text="{Binding Name}" />
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
            <ListBox.ItemContainerStyle>
                <Style TargetType="{x:Type ListBoxItem}">
                    <EventSetter Event="MouseMove" Handler="ListViewItem_MouseMove" />
                    <EventSetter Event="PreviewMouseLeftButtonDown" Handler="ListViewItem_MouseLeftButtonDown" />
                    <EventSetter Event="DragOver" Handler="ListViewItem_DragOver" />
                </Style>
            </ListBox.ItemContainerStyle>
        </ListBox>
    </Grid>
</Window>
